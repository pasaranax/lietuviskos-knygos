{
  "provider": "Azure Speech",
  "sourceSha256": "1ace7bdf071ba3595e526e07ad0b5ff3c68eb9264a65b05b7bc091ed8f945aa1",
  "timingVersion": 2,
  "voiceSwitchGapSeconds": 0.0625,
  "sampleRate": 24000,
  "duration": 277.08,
  "phrases": [
    {
      "mark": "p-000-i-000",
      "block": 0,
      "item": 0,
      "text": "Kitą penktadienį Tomas grįžo namo be dvidešimties šeštą.",
      "voice": "lt-LT-LeonasNeural",
      "start": 0,
      "end": 4.4375,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-000-i-000.mp3"
    },
    {
      "mark": "p-000-i-001",
      "block": 0,
      "item": 1,
      "text": "Vienoje rankoje laikė pirkinių maišelį,",
      "voice": "lt-LT-LeonasNeural",
      "start": 4.4375,
      "end": 6.7625,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-000-i-001.mp3"
    },
    {
      "mark": "p-000-i-002",
      "block": 0,
      "item": 2,
      "text": "kitoje — sulankstytą popierinį sąrašą.",
      "voice": "lt-LT-LeonasNeural",
      "start": 6.7625,
      "end": 10.125,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-000-i-002.mp3"
    },
    {
      "mark": "p-001-i-000",
      "block": 1,
      "item": 0,
      "text": "Pilnas planas baigėsi pirmadienį.",
      "voice": "lt-LT-LeonasNeural",
      "start": 10.125,
      "end": 13.075,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-001-i-000.mp3"
    },
    {
      "mark": "p-001-i-001",
      "block": 1,
      "item": 1,
      "text": "Ekrane liko kalendorius, sąrašai ir priminimai.",
      "voice": "lt-LT-LeonasNeural",
      "start": 13.075,
      "end": 16.875,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-001-i-001.mp3"
    },
    {
      "mark": "p-002-i-000",
      "block": 2,
      "item": 0,
      "text": "— Priminimas: pradėti gaminti šeštą valandą.",
      "voice": "lt-LT-LeonasNeural",
      "start": 16.875,
      "end": 20.6,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-002-i-000.mp3"
    },
    {
      "mark": "p-003-i-000",
      "block": 3,
      "item": 0,
      "text": "— Žinau. Šį priminimą įrašiau pats.",
      "voice": "lt-LT-LeonasNeural",
      "start": 20.6,
      "end": 25.2625,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-003-i-000.mp3"
    },
    {
      "mark": "p-004-i-000",
      "block": 4,
      "item": 0,
      "text": "Tomas išdėjo produktus ant stalo.",
      "voice": "lt-LT-LeonasNeural",
      "start": 25.2625,
      "end": 28.45,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-004-i-000.mp3"
    },
    {
      "mark": "p-004-i-001",
      "block": 4,
      "item": 1,
      "text": "Dvi bulvės, du kiaušiniai, pomidorai, sūris ir duona.",
      "voice": "lt-LT-LeonasNeural",
      "start": 28.45,
      "end": 33.125,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-004-i-001.mp3"
    },
    {
      "mark": "p-005-i-000",
      "block": 5,
      "item": 0,
      "text": "Druska jau stovėjo prie viryklės.",
      "voice": "lt-LT-LeonasNeural",
      "start": 33.125,
      "end": 36.1625,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-005-i-000.mp3"
    },
    {
      "mark": "p-005-i-001",
      "block": 5,
      "item": 1,
      "text": "Šį kartą jos pamiršti negalėjo.",
      "voice": "lt-LT-LeonasNeural",
      "start": 36.1625,
      "end": 39.25,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-005-i-001.mp3"
    },
    {
      "mark": "p-006-i-000",
      "block": 6,
      "item": 0,
      "text": "Prieš gamindamas Tomas parašė Ievai.",
      "voice": "lt-LT-LeonasNeural",
      "start": 39.25,
      "end": 42.4125,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-006-i-000.mp3"
    },
    {
      "mark": "p-006-i-001",
      "block": 6,
      "item": 1,
      "text": "„Vakarienė septintą. Ar vis dar tinka?“",
      "voice": "lt-LT-LeonasNeural",
      "start": 42.4125,
      "end": 47.025,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-006-i-001.mp3"
    },
    {
      "mark": "p-007-i-000",
      "block": 7,
      "item": 0,
      "text": "Atsakymas atėjo po minutės.",
      "voice": "lt-LT-LeonasNeural",
      "start": 47.025,
      "end": 50.0125,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-007-i-000.mp3"
    },
    {
      "mark": "p-008-i-000",
      "block": 8,
      "item": 0,
      "text": "— Tinka. Būsiu septintą.",
      "voice": "lt-LT-OnaNeural",
      "start": 50.0125,
      "end": 54.075,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-008-i-000.mp3"
    },
    {
      "mark": "p-009-i-000",
      "block": 9,
      "item": 0,
      "text": "Tomas įjungė orkaitę ir atidarė Rasos receptą.",
      "voice": "lt-LT-LeonasNeural",
      "start": 54.075,
      "end": 58.1375,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-009-i-000.mp3"
    },
    {
      "mark": "p-009-i-001",
      "block": 9,
      "item": 1,
      "text": "Šalia gulėjo jo paties pastaba.",
      "voice": "lt-LT-LeonasNeural",
      "start": 58.1375,
      "end": 61.2,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-009-i-001.mp3"
    },
    {
      "mark": "p-010-i-000",
      "block": 10,
      "item": 0,
      "text": "„Druską dėti prieš kepimą.“",
      "voice": "lt-LT-LeonasNeural",
      "start": 61.2,
      "end": 63.925,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-010-i-000.mp3"
    },
    {
      "mark": "p-010-i-001",
      "block": 10,
      "item": 1,
      "text": "Tomas perskaitė sakinį garsiai.",
      "voice": "lt-LT-LeonasNeural",
      "start": 63.925,
      "end": 66.8625,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-010-i-001.mp3"
    },
    {
      "mark": "p-011-i-000",
      "block": 11,
      "item": 0,
      "text": "— Geras patarimas.",
      "voice": "lt-LT-LeonasNeural",
      "start": 66.8625,
      "end": 68.975,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-011-i-000.mp3"
    },
    {
      "mark": "p-012-i-000",
      "block": 12,
      "item": 0,
      "text": "Bulves jis supjaustė ploniau negu šeštadienį.",
      "voice": "lt-LT-LeonasNeural",
      "start": 68.975,
      "end": 72.65,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-012-i-000.mp3"
    },
    {
      "mark": "p-012-i-001",
      "block": 12,
      "item": 1,
      "text": "Tada įmušė kiaušinius ir užbėrė sūrio.",
      "voice": "lt-LT-LeonasNeural",
      "start": 72.65,
      "end": 76.2625,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-012-i-001.mp3"
    },
    {
      "mark": "p-013-i-000",
      "block": 13,
      "item": 0,
      "text": "Ant viršaus sudėjo pomidorų gabaliukus.",
      "voice": "lt-LT-LeonasNeural",
      "start": 76.2625,
      "end": 79.5625,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-013-i-000.mp3"
    },
    {
      "mark": "p-013-i-001",
      "block": 13,
      "item": 1,
      "text": "Formą įdėjo į karštą orkaitę.",
      "voice": "lt-LT-LeonasNeural",
      "start": 79.5625,
      "end": 82.45,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-013-i-001.mp3"
    },
    {
      "mark": "p-014-i-000",
      "block": 14,
      "item": 0,
      "text": "— Priminimas po dvidešimties minučių.",
      "voice": "lt-LT-LeonasNeural",
      "start": 82.45,
      "end": 85.5,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-014-i-000.mp3"
    },
    {
      "mark": "p-015-i-000",
      "block": 15,
      "item": 0,
      "text": "Kol maistas kepė, Tomas padengė stalą.",
      "voice": "lt-LT-LeonasNeural",
      "start": 85.5,
      "end": 89.0,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-015-i-000.mp3"
    },
    {
      "mark": "p-015-i-001",
      "block": 15,
      "item": 1,
      "text": "Pastatė dvi lėkštes ir dvi stiklines.",
      "voice": "lt-LT-LeonasNeural",
      "start": 89.0,
      "end": 92.375,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-015-i-001.mp3"
    },
    {
      "mark": "p-016-i-000",
      "block": 16,
      "item": 0,
      "text": "Duoną supjaustė, bet jos neuždengė.",
      "voice": "lt-LT-LeonasNeural",
      "start": 92.375,
      "end": 95.9375,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-016-i-000.mp3"
    },
    {
      "mark": "p-016-i-001",
      "block": 16,
      "item": 1,
      "text": "Po kelių minučių prisiminė ir uždengė rankšluosčiu.",
      "voice": "lt-LT-LeonasNeural",
      "start": 95.9375,
      "end": 99.7875,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-016-i-001.mp3"
    },
    {
      "mark": "p-017-i-000",
      "block": 17,
      "item": 0,
      "text": "Priminimas suskambo lygiai šešios dvidešimt.",
      "voice": "lt-LT-LeonasNeural",
      "start": 99.7875,
      "end": 103.425,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-017-i-000.mp3"
    },
    {
      "mark": "p-017-i-001",
      "block": 17,
      "item": 1,
      "text": "Tomas šakute patikrino bulvę viduryje.",
      "voice": "lt-LT-LeonasNeural",
      "start": 103.425,
      "end": 106.875,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-017-i-001.mp3"
    },
    {
      "mark": "p-018-i-000",
      "block": 18,
      "item": 0,
      "text": "Kraštai jau buvo rudi, bet vidurys dar kietas.",
      "voice": "lt-LT-LeonasNeural",
      "start": 106.875,
      "end": 110.6375,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-018-i-000.mp3"
    },
    {
      "mark": "p-018-i-001",
      "block": 18,
      "item": 1,
      "text": "Iki septintos liko keturiasdešimt minučių.",
      "voice": "lt-LT-LeonasNeural",
      "start": 110.6375,
      "end": 114.1375,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-018-i-001.mp3"
    },
    {
      "mark": "p-019-i-000",
      "block": 19,
      "item": 0,
      "text": "Anksčiau Tomas būtų ieškojęs maisto pristatymo.",
      "voice": "lt-LT-LeonasNeural",
      "start": 114.1375,
      "end": 118.0625,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-019-i-000.mp3"
    },
    {
      "mark": "p-019-i-001",
      "block": 19,
      "item": 1,
      "text": "Dabar jis tik pamaišė bulves",
      "voice": "lt-LT-LeonasNeural",
      "start": 118.0625,
      "end": 119.8,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-019-i-001.mp3"
    },
    {
      "mark": "p-019-i-002",
      "block": 19,
      "item": 2,
      "text": "ir nustatė dar dešimt minučių.",
      "voice": "lt-LT-LeonasNeural",
      "start": 119.8,
      "end": 122.575,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-019-i-002.mp3"
    },
    {
      "mark": "p-020-i-000",
      "block": 20,
      "item": 0,
      "text": "— Priminti, kai laikas baigsis?",
      "voice": "lt-LT-LeonasNeural",
      "start": 122.575,
      "end": 125.4625,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-020-i-000.mp3"
    },
    {
      "mark": "p-021-i-000",
      "block": 21,
      "item": 0,
      "text": "— Taip. Daugiau nieko nereikia.",
      "voice": "lt-LT-LeonasNeural",
      "start": 125.4625,
      "end": 129.625,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-021-i-000.mp3"
    },
    {
      "mark": "p-022-i-000",
      "block": 22,
      "item": 0,
      "text": "Po dešimties minučių bulvė buvo minkšta.",
      "voice": "lt-LT-LeonasNeural",
      "start": 129.625,
      "end": 133.0625,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-022-i-000.mp3"
    },
    {
      "mark": "p-022-i-001",
      "block": 22,
      "item": 1,
      "text": "Vienas kraštas apskrudo daugiau, bet nesudegė.",
      "voice": "lt-LT-LeonasNeural",
      "start": 133.0625,
      "end": 137.125,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-022-i-001.mp3"
    },
    {
      "mark": "p-023-i-000",
      "block": 23,
      "item": 0,
      "text": "Tomas paragavo mažą gabaliuką.",
      "voice": "lt-LT-LeonasNeural",
      "start": 137.125,
      "end": 140.1875,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-023-i-000.mp3"
    },
    {
      "mark": "p-023-i-001",
      "block": 23,
      "item": 1,
      "text": "Druskos užteko.",
      "voice": "lt-LT-LeonasNeural",
      "start": 140.1875,
      "end": 142.4875,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-023-i-001.mp3"
    },
    {
      "mark": "p-024-i-000",
      "block": 24,
      "item": 0,
      "text": "Be penkių septynios ant stalo buvo dvi porcijos.",
      "voice": "lt-LT-LeonasNeural",
      "start": 142.4875,
      "end": 146.3125,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-024-i-000.mp3"
    },
    {
      "mark": "p-024-i-001",
      "block": 24,
      "item": 1,
      "text": "Tomas atsisėdo, bet tuoj vėl atsistojo.",
      "voice": "lt-LT-LeonasNeural",
      "start": 146.3125,
      "end": 150.0,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-024-i-001.mp3"
    },
    {
      "mark": "p-025-i-000",
      "block": 25,
      "item": 0,
      "text": "Patikrino duoną, stiklines ir savo marškinius.",
      "voice": "lt-LT-LeonasNeural",
      "start": 150.0,
      "end": 153.775,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-025-i-000.mp3"
    },
    {
      "mark": "p-025-i-001",
      "block": 25,
      "item": 1,
      "text": "Tada nusijuokė pats iš savęs.",
      "voice": "lt-LT-LeonasNeural",
      "start": 153.775,
      "end": 156.5375,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-025-i-001.mp3"
    },
    {
      "mark": "p-026-i-000",
      "block": 26,
      "item": 0,
      "text": "— Viskas jau paruošta.",
      "voice": "lt-LT-LeonasNeural",
      "start": 156.5375,
      "end": 158.95,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-026-i-000.mp3"
    },
    {
      "mark": "p-027-i-000",
      "block": 27,
      "item": 0,
      "text": "Septintą suskambo durų skambutis.",
      "voice": "lt-LT-LeonasNeural",
      "start": 158.95,
      "end": 162.075,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-027-i-000.mp3"
    },
    {
      "mark": "p-028-i-000",
      "block": 28,
      "item": 0,
      "text": "Tomas atidarė duris.",
      "voice": "lt-LT-LeonasNeural",
      "start": 162.075,
      "end": 164.525,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-028-i-000.mp3"
    },
    {
      "mark": "p-028-i-001",
      "block": 28,
      "item": 1,
      "text": "Ieva stovėjo su mažu žaliu dubeniu.",
      "voice": "lt-LT-LeonasNeural",
      "start": 164.525,
      "end": 167.8,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-028-i-001.mp3"
    },
    {
      "mark": "p-029-i-000",
      "block": 29,
      "item": 0,
      "text": "— Atsinešiau salotų.",
      "voice": "lt-LT-OnaNeural",
      "start": 167.8,
      "end": 170.2625,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-029-i-000.mp3"
    },
    {
      "mark": "p-030-i-000",
      "block": 30,
      "item": 0,
      "text": "— Puiku. O aš pagaminau dvi porcijas.",
      "voice": "lt-LT-LeonasNeural",
      "start": 170.2625,
      "end": 175.1625,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-030-i-000.mp3"
    },
    {
      "mark": "p-031-i-000",
      "block": 31,
      "item": 0,
      "text": "— Be grietinėlės?",
      "voice": "lt-LT-OnaNeural",
      "start": 175.1625,
      "end": 177.6,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-031-i-000.mp3"
    },
    {
      "mark": "p-032-i-000",
      "block": 32,
      "item": 0,
      "text": "— Be grietinėlės. Ir be užsakymo.",
      "voice": "lt-LT-LeonasNeural",
      "start": 177.6,
      "end": 182.025,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-032-i-000.mp3"
    },
    {
      "mark": "p-033-i-000",
      "block": 33,
      "item": 0,
      "text": "Ieva padėjo dubenį ant stalo",
      "voice": "lt-LT-LeonasNeural",
      "start": 182.025,
      "end": 183.9375,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-033-i-000.mp3"
    },
    {
      "mark": "p-033-i-001",
      "block": 33,
      "item": 1,
      "text": "ir nusivilko striukę.",
      "voice": "lt-LT-LeonasNeural",
      "start": 183.9375,
      "end": 186.1875,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-033-i-001.mp3"
    },
    {
      "mark": "p-034-i-000",
      "block": 34,
      "item": 0,
      "text": "— Labai gerai kvepia.",
      "voice": "lt-LT-OnaNeural",
      "start": 186.1875,
      "end": 188.7125,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-034-i-000.mp3"
    },
    {
      "mark": "p-035-i-000",
      "block": 35,
      "item": 0,
      "text": "— Ar tėčio virtuvę jau sutvarkei?",
      "voice": "lt-LT-LeonasNeural",
      "start": 188.7125,
      "end": 191.7,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-035-i-000.mp3"
    },
    {
      "mark": "p-036-i-000",
      "block": 36,
      "item": 0,
      "text": "— Beveik. Viena spintelė vis dar pilna.",
      "voice": "lt-LT-OnaNeural",
      "start": 191.7,
      "end": 196.925,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-036-i-000.mp3"
    },
    {
      "mark": "p-036-i-001",
      "block": 36,
      "item": 1,
      "text": "Bet šiandien apie ją negalvosiu.",
      "voice": "lt-LT-OnaNeural",
      "start": 196.925,
      "end": 200.0,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-036-i-001.mp3"
    },
    {
      "mark": "p-037-i-000",
      "block": 37,
      "item": 0,
      "text": "Jie įsidėjo bulvių ir salotų.",
      "voice": "lt-LT-LeonasNeural",
      "start": 200.0,
      "end": 202.925,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-037-i-000.mp3"
    },
    {
      "mark": "p-037-i-001",
      "block": 37,
      "item": 1,
      "text": "Vienas bulvės kraštas buvo labai traškus.",
      "voice": "lt-LT-LeonasNeural",
      "start": 202.925,
      "end": 206.3875,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-037-i-001.mp3"
    },
    {
      "mark": "p-037-i-002",
      "block": 37,
      "item": 2,
      "text": "Vidurys buvo minkštas.",
      "voice": "lt-LT-LeonasNeural",
      "start": 206.3875,
      "end": 208.825,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-037-i-002.mp3"
    },
    {
      "mark": "p-038-i-000",
      "block": 38,
      "item": 0,
      "text": "— Penkiomis minutėmis per ilgai?",
      "voice": "lt-LT-LeonasNeural",
      "start": 208.825,
      "end": 211.8,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-038-i-000.mp3"
    },
    {
      "mark": "p-039-i-000",
      "block": 39,
      "item": 0,
      "text": "— Gal dviem. Bet skanu.",
      "voice": "lt-LT-OnaNeural",
      "start": 211.8,
      "end": 215.8375,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-039-i-000.mp3"
    },
    {
      "mark": "p-040-i-000",
      "block": 40,
      "item": 0,
      "text": "Tomas nepasakė, kad vakarienė nepavyko.",
      "voice": "lt-LT-LeonasNeural",
      "start": 215.8375,
      "end": 219.2875,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-040-i-000.mp3"
    },
    {
      "mark": "p-040-i-001",
      "block": 40,
      "item": 1,
      "text": "Jis tik užrašė mintyse: kitą kartą trumpiau.",
      "voice": "lt-LT-LeonasNeural",
      "start": 219.2875,
      "end": 223.0125,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-040-i-001.mp3"
    },
    {
      "mark": "p-041-i-000",
      "block": 41,
      "item": 0,
      "text": "Valgydami jie kalbėjo apie savaitę.",
      "voice": "lt-LT-LeonasNeural",
      "start": 223.0125,
      "end": 226.225,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-041-i-000.mp3"
    },
    {
      "mark": "p-041-i-001",
      "block": 41,
      "item": 1,
      "text": "Tomas papasakojo apie trumpą kavą su Antanu.",
      "voice": "lt-LT-LeonasNeural",
      "start": 226.225,
      "end": 230.225,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-041-i-001.mp3"
    },
    {
      "mark": "p-042-i-000",
      "block": 42,
      "item": 0,
      "text": "— Sekmadienį tikrai nebūčiau galėjusi ateiti.",
      "voice": "lt-LT-OnaNeural",
      "start": 230.225,
      "end": 234.0125,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-042-i-000.mp3"
    },
    {
      "mark": "p-043-i-000",
      "block": 43,
      "item": 0,
      "text": "— Gerai, kad neperkėlėme visko į sekmadienį.",
      "voice": "lt-LT-LeonasNeural",
      "start": 234.0125,
      "end": 237.45,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-043-i-000.mp3"
    },
    {
      "mark": "p-044-i-000",
      "block": 44,
      "item": 0,
      "text": "— Viena trumpa kava ir viena vakarienė",
      "voice": "lt-LT-LeonasNeural",
      "start": 237.45,
      "end": 239.5625,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-044-i-000.mp3"
    },
    {
      "mark": "p-044-i-001",
      "block": 44,
      "item": 1,
      "text": "geriau negu vienas neįmanomas planas.",
      "voice": "lt-LT-LeonasNeural",
      "start": 239.5625,
      "end": 242.65,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-044-i-001.mp3"
    },
    {
      "mark": "p-045-i-000",
      "block": 45,
      "item": 0,
      "text": "Ieva pakėlė stiklinę.",
      "voice": "lt-LT-LeonasNeural",
      "start": 242.65,
      "end": 245.375,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-045-i-000.mp3"
    },
    {
      "mark": "p-046-i-000",
      "block": 46,
      "item": 0,
      "text": "— Už įmanomus planus.",
      "voice": "lt-LT-OnaNeural",
      "start": 245.375,
      "end": 247.9,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-046-i-000.mp3"
    },
    {
      "mark": "p-047-i-000",
      "block": 47,
      "item": 0,
      "text": "— Ir už bulves, kurioms prireikė dešimties minučių.",
      "voice": "lt-LT-LeonasNeural",
      "start": 247.9,
      "end": 251.8875,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-047-i-000.mp3"
    },
    {
      "mark": "p-048-i-000",
      "block": 48,
      "item": 0,
      "text": "Po vakarienės lėkštės buvo tuščios.",
      "voice": "lt-LT-LeonasNeural",
      "start": 251.8875,
      "end": 255.0375,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-048-i-000.mp3"
    },
    {
      "mark": "p-048-i-001",
      "block": 48,
      "item": 1,
      "text": "Ieva nunešė jas prie kriauklės.",
      "voice": "lt-LT-LeonasNeural",
      "start": 255.0375,
      "end": 258.0375,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-048-i-001.mp3"
    },
    {
      "mark": "p-049-i-000",
      "block": 49,
      "item": 0,
      "text": "— Kitą kartą aš gaminsiu.",
      "voice": "lt-LT-OnaNeural",
      "start": 258.0375,
      "end": 260.8375,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-049-i-000.mp3"
    },
    {
      "mark": "p-050-i-000",
      "block": 50,
      "item": 0,
      "text": "— Tada tu pasirinksi laiką.",
      "voice": "lt-LT-LeonasNeural",
      "start": 260.8375,
      "end": 263.45,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-050-i-000.mp3"
    },
    {
      "mark": "p-051-i-000",
      "block": 51,
      "item": 0,
      "text": "— Susitarsime patys.",
      "voice": "lt-LT-OnaNeural",
      "start": 263.45,
      "end": 266.05,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-051-i-000.mp3"
    },
    {
      "mark": "p-052-i-000",
      "block": 52,
      "item": 0,
      "text": "Ant stalo liko dvi tuščios vietos.",
      "voice": "lt-LT-LeonasNeural",
      "start": 266.05,
      "end": 269.275,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-052-i-000.mp3"
    },
    {
      "mark": "p-052-i-001",
      "block": 52,
      "item": 1,
      "text": "Pirmą vakarą Tomas nežinojo, kam reikėjo dviejų porcijų.",
      "voice": "lt-LT-LeonasNeural",
      "start": 269.275,
      "end": 273.5875,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-052-i-001.mp3"
    },
    {
      "mark": "p-052-i-002",
      "block": 52,
      "item": 2,
      "text": "Šį kartą jis pats pasirinko, kam gaminti.",
      "voice": "lt-LT-LeonasNeural",
      "start": 273.5875,
      "end": 277.08,
      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-12/p-052-i-002.mp3"
    }
  ],

      "audio": "assets/audio/jusu-iprastas-uzsakymas/chapter-2/p-064-i-000.mp3"
    },
    {
      "mark": "p-065-i-000",
      "block": 65,
      "item": 0,
      "text": "Ji paėmė skėtį. Tomas uždarė duris tyliai.",

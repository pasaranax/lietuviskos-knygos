      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-033-i-000.mp3"
    },
    {
      "mark": "p-033-i-001",
      "block": 33,
      "item": 1,
      "text": "Šalia padėjo pinigų už kelionę.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 5913588,
      "speechStartFrame": 5926488,
      "speechEndFrame": 5970888,
      "endFrame": 5985588,
      "start": 246.3995,
      "end": 249.3995,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-033-i-001.mp3"
    },
    {
      "mark": "p-033-i-002",
      "block": 33,
      "item": 2,
      "text": "Piešinių knygą Agnė paliko ant savo stalo.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 5985588,
      "speechStartFrame": 6000288,
      "speechEndFrame": 6061188,
      "endFrame": 6074988,
      "start": 249.3995,
      "end": 253.1245,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-033-i-002.mp3"
    },
    {
      "mark": "p-033-i-003",
      "block": 33,
      "item": 3,
      "text": "Užversti jos Elzė neprašė.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 6074988,
      "speechStartFrame": 6088788,
      "speechEndFrame": 6138888,
      "endFrame": 6153138,
      "start": 253.1245,
      "end": 256.38075,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-033-i-003.mp3"
    },
    {
      "mark": "p-034-i-000",
      "block": 34,
      "item": 0,
      "text": "Bibliotekoje Lina apžiūrėjo viršelį ir puslapius.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 6153138,
      "speechStartFrame": 6167388,
      "speechEndFrame": 6236088,
      "endFrame": 6248538,
      "start": 256.38075,
      "end": 260.35575,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-034-i-000.mp3"
    },
    {
      "mark": "p-034-i-001",
      "block": 34,
      "item": 1,
      "text": "Padėjo knygą į jos vietą lentynoje.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 6248538,
      "speechStartFrame": 6260988,
      "speechEndFrame": 6312888,
      "endFrame": 6326388,
      "start": 260.35575,
      "end": 263.5995,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-034-i-001.mp3"
    },
    {
      "mark": "p-034-i-002",
      "block": 34,
      "item": 2,
      "text": "Matas laukė prie durų.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 6326388,
      "speechStartFrame": 6339888,
      "speechEndFrame": 6374088,
      "endFrame": 6387888,

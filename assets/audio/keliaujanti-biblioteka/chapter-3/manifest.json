  "phrases": [
    {
      "mark": "p-000-i-000",
      "block": 0,
      "item": 0,
      "text": "Po pietų Lina grįžo pas Elzę.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 0,
      "speechStartFrame": 3900,
      "speechEndFrame": 48600,
      "endFrame": 62700,
      "start": 0.0,
      "end": 2.6125,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-000-i-000.mp3"
    },
    {
      "mark": "p-000-i-001",
      "block": 0,
      "item": 1,
      "text": "Atnešė šilto vandens ir duonos.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 62700,
      "speechStartFrame": 76800,
      "speechEndFrame": 125700,
      "endFrame": 139350,
      "start": 2.6125,
      "end": 5.80625,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-000-i-001.mp3"
    },
    {
      "mark": "p-000-i-002",
      "block": 0,
      "item": 2,
      "text": "Elzė dar skaitė. Ant kelių gulėjo knyga.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 139350,
      "speechStartFrame": 153000,
      "speechEndFrame": 243300,
      "endFrame": 256500,
      "start": 5.80625,
      "end": 10.6875,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-000-i-002.mp3"
    },
    {
      "mark": "p-000-i-003",
      "block": 0,
      "item": 3,
      "text": "Puodelis prie lango buvo tuščias.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 256500,
      "speechStartFrame": 269700,
      "speechEndFrame": 318300,
      "endFrame": 331500,
      "start": 10.6875,
      "end": 13.8125,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-000-i-003.mp3"
    },
    {
      "mark": "p-001-i-000",
      "block": 1,
      "item": 0,
      "text": "Knygoje tėvas dirbo dukros namuose.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 331500,
      "speechStartFrame": 344700,
      "speechEndFrame": 399900,
      "endFrame": 414600,
      "start": 13.8125,
      "end": 17.275,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-001-i-000.mp3"
    },
    {
      "mark": "p-001-i-001",
      "block": 1,
      "item": 1,
      "text": "Ten atsivežė savo darbo stalą.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 414600,
      "speechStartFrame": 429300,
      "speechEndFrame": 476700,
      "endFrame": 489900,
      "start": 17.275,
      "end": 20.4125,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-001-i-001.mp3"
    },
    {
      "mark": "p-001-i-002",
      "block": 1,
      "item": 2,
      "text": "Kėdę jis jau padarė.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 489900,
      "speechStartFrame": 503100,
      "speechEndFrame": 533700,
      "endFrame": 547950,
      "start": 20.4125,
      "end": 22.83125,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-001-i-002.mp3"
    },
    {
      "mark": "p-001-i-003",
      "block": 1,
      "item": 3,
      "text": "Dukra norėjo pastatyti ją prie lango.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 547950,
      "speechStartFrame": 562200,
      "speechEndFrame": 614100,
      "endFrame": 627600,
      "start": 22.83125,
      "end": 26.15,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-001-i-003.mp3"
    },
    {
      "mark": "p-001-i-004",
      "block": 1,
      "item": 4,
      "text": "Bet ten stovėjo sunkus stalas.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 627600,
      "speechStartFrame": 641100,
      "speechEndFrame": 686700,
      "endFrame": 699450,
      "start": 26.15,
      "end": 29.14375,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-001-i-004.mp3"
    },
    {
      "mark": "p-002-i-000",
      "block": 2,
      "item": 0,
      "text": "Tėvas padėjo abi rankas ant stalo.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 699450,
      "speechStartFrame": 712200,
      "speechEndFrame": 764100,
      "endFrame": 777300,
      "start": 29.14375,
      "end": 32.3875,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-002-i-000.mp3"
    },
    {
      "mark": "p-002-i-001",
      "block": 2,
      "item": 1,
      "text": "Stūmė. Stalas nepajudėjo.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 777300,
      "speechStartFrame": 790500,
      "speechEndFrame": 867000,
      "endFrame": 879900,
      "start": 32.3875,
      "end": 36.6625,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-002-i-001.mp3"
    },
    {
      "mark": "p-002-i-002",
      "block": 2,
      "item": 2,
      "text": "Jis atsisėdo ant naujos kėdės.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 879900,
      "speechStartFrame": 892800,
      "speechEndFrame": 939900,
      "endFrame": 953250,
      "start": 36.6625,
      "end": 39.71875,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-002-i-002.mp3"
    },
    {
      "mark": "p-002-i-003",
      "block": 2,
      "item": 3,
      "text": "Ilgai žiūrėjo į grindis.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 953250,
      "speechStartFrame": 966600,
      "speechEndFrame": 1002300,
      "endFrame": 1024704,
      "start": 39.71875,
      "end": 42.696,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-002-i-003.mp3"
    },
    {
      "mark": "p-003-i-000",
      "block": 3,
      "item": 0,
      "text": "„Galiu pakviesti kaimyną.“",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 1024704,
      "speechStartFrame": 1027104,
      "speechEndFrame": 1065804,
      "endFrame": 1089792,
      "start": 42.696,
      "end": 45.408,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-003-i-000.mp3"
    },
    {
      "mark": "p-004-i-000",
      "block": 4,
      "item": 0,
      "text": "„Jis pasakys, kad man jau nereikia",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 1089792,
      "speechStartFrame": 1093992,
      "speechEndFrame": 1137192,
      "endFrame": 1137492,
      "start": 45.408,
      "end": 47.3955,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-004-i-000.mp3"
    },
    {
      "mark": "p-004-i-001",
      "block": 4,
      "item": 1,
      "text": "tokio stalo.“",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 1137492,
      "speechStartFrame": 1137792,
      "speechEndFrame": 1158192,
      "endFrame": 1180224,
      "start": 47.3955,
      "end": 49.176,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-004-i-001.mp3"
    },
    {
      "mark": "p-005-i-000",
      "block": 5,
      "item": 0,
      "text": "„Tai tavo stalas. Mes tik perkelsime jį.“",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 1180224,
      "speechStartFrame": 1182924,
      "speechEndFrame": 1273824,
      "endFrame": 1298880,
      "start": 49.176,
      "end": 54.12,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-005-i-000.mp3"
    },
    {
      "mark": "p-006-i-000",
      "block": 6,
      "item": 0,
      "text": "Elzė pakėlė galvą.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 1298880,
      "speechStartFrame": 1303980,
      "speechEndFrame": 1339380,
      "endFrame": 1351380,
      "start": 54.12,
      "end": 56.3075,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-006-i-000.mp3"
    },
    {
      "mark": "p-006-i-001",
      "block": 6,
      "item": 1,
      "text": "Agnė ant popieriaus piešė kišenę.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 1351380,
      "speechStartFrame": 1363380,
      "speechEndFrame": 1412580,
      "endFrame": 1427130,
      "start": 56.3075,
      "end": 59.46375,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-006-i-001.mp3"
    },
    {
      "mark": "p-006-i-002",
      "block": 6,
      "item": 2,
      "text": "Piešinių knyga gulėjo atversta šalia.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 1427130,
      "speechStartFrame": 1441680,
      "speechEndFrame": 1495980,
      "endFrame": 1518912,
      "start": 59.46375,
      "end": 63.288,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-006-i-002.mp3"
    },
    {
      "mark": "p-007-i-000",
      "block": 7,
      "item": 0,
      "text": "— Ką pakeitei?",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 1518912,
      "speechStartFrame": 1523412,
      "speechEndFrame": 1546812,
      "endFrame": 1559112,
      "start": 63.288,
      "end": 64.963,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-007-i-000.mp3"
    },
    {
      "mark": "p-008-i-000",
      "block": 8,
      "item": 0,
      "text": "— Noriu padaryti kišenę šiek tiek didesnę.",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 1559112,
      "speechStartFrame": 1571412,
      "speechEndFrame": 1631412,
      "endFrame": 1643712,
      "start": 64.963,
      "end": 68.488,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-008-i-000.mp3"
    },
    {
      "mark": "p-008-i-001",
      "block": 8,
      "item": 1,
      "text": "Senoje yra skylė.",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 1643712,
      "speechStartFrame": 1656012,
      "speechEndFrame": 1691712,
      "endFrame": 1705212,
      "start": 68.488,
      "end": 71.0505,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-008-i-001.mp3"
    },
    {
      "mark": "p-009-i-000",
      "block": 9,
      "item": 0,
      "text": "— Seną kišenę išimsiu.",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 1705212,
      "speechStartFrame": 1718712,
      "speechEndFrame": 1759212,
      "endFrame": 1784448,
      "start": 71.0505,
      "end": 74.352,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-009-i-000.mp3"
    },
    {
      "mark": "p-010-i-000",
      "block": 10,
      "item": 0,
      "text": "Elzė padėjo ranką ant palto.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 1784448,
      "speechStartFrame": 1789548,
      "speechEndFrame": 1834848,
      "endFrame": 1849398,
      "start": 74.352,
      "end": 77.05825,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-010-i-000.mp3"
    },
    {
      "mark": "p-010-i-001",
      "block": 10,
      "item": 1,
      "text": "Agnė sustojo.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 1849398,
      "speechStartFrame": 1863948,
      "speechEndFrame": 1889148,
      "endFrame": 1912896,
      "start": 77.05825,
      "end": 79.704,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-010-i-001.mp3"
    },
    {
      "mark": "p-011-i-000",
      "block": 11,
      "item": 0,
      "text": "— Žiūrėk. Šitą vietą jis siuvo du kartus.",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 1912896,
      "speechStartFrame": 1915896,
      "speechEndFrame": 2007696,
      "endFrame": 2020446,
      "start": 79.704,
      "end": 84.18525,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-011-i-000.mp3"
    },
    {
      "mark": "p-011-i-001",
      "block": 11,
      "item": 1,
      "text": "Pirmą kartą paliko skylę.",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 2020446,
      "speechStartFrame": 2033196,
      "speechEndFrame": 2071596,
      "endFrame": 2084646,
      "start": 84.18525,
      "end": 86.86025,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-011-i-001.mp3"
    },
    {
      "mark": "p-011-i-002",
      "block": 11,
      "item": 2,
      "text": "Mes juokėmės, kad saldainiai pabėgs.",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 2084646,
      "speechStartFrame": 2097696,
      "speechEndFrame": 2151396,
      "endFrame": 2164746,
      "start": 86.86025,
      "end": 90.19775,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-011-i-002.mp3"
    },
    {
      "mark": "p-012-i-000",
      "block": 12,
      "item": 0,
      "text": "— Gal seną paliekame viduje?",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 2164746,
      "speechStartFrame": 2178096,
      "speechEndFrame": 2222496,
      "endFrame": 2235546,
      "start": 90.19775,
      "end": 93.14775,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-012-i-000.mp3"
    },
    {
      "mark": "p-012-i-001",
      "block": 12,
      "item": 1,
      "text": "O naują siuvame šalia.",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 2235546,
      "speechStartFrame": 2248596,
      "speechEndFrame": 2282496,
      "endFrame": 2307456,
      "start": 93.14775,
      "end": 96.144,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-012-i-001.mp3"
    },
    {
      "mark": "p-013-i-000",
      "block": 13,
      "item": 0,
      "text": "Elzė lėtai pakėlė ranką nuo palto.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 2307456,
      "speechStartFrame": 2312556,
      "speechEndFrame": 2365056,
      "endFrame": 2390400,
      "start": 96.144,
      "end": 99.6,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-013-i-000.mp3"
    },
    {
      "mark": "p-014-i-000",
      "block": 14,
      "item": 0,
      "text": "— Taip. Čia, prie šitos siūlės.",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 2390400,
      "speechStartFrame": 2395500,
      "speechEndFrame": 2474400,
      "endFrame": 2498688,
      "start": 99.6,
      "end": 104.112,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-014-i-000.mp3"
    },
    {
      "mark": "p-015-i-000",
      "block": 15,
      "item": 0,
      "text": "Elzė įdėjo lapelį į savo knygą.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 2498688,
      "speechStartFrame": 2503488,
      "speechEndFrame": 2555388,
      "endFrame": 2568138,
      "start": 104.112,
      "end": 107.00575,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-015-i-000.mp3"
    },
    {
      "mark": "p-015-i-001",
      "block": 15,
      "item": 1,
      "text": "Pažiūrėjo į piešinį, tada atidarė stalčių.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 2568138,
      "speechStartFrame": 2580888,
      "speechEndFrame": 2642688,
      "endFrame": 2655138,
      "start": 107.00575,
      "end": 110.63075,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-015-i-001.mp3"
    },
    {
      "mark": "p-015-i-002",
      "block": 15,
      "item": 2,
      "text": "Pastūmė Agnei mažą maišelį saldainių.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 2655138,
      "speechStartFrame": 2667588,
      "speechEndFrame": 2725188,
      "endFrame": 2748096,
      "start": 110.63075,
      "end": 114.504,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-015-i-002.mp3"
    },
    {
      "mark": "p-016-i-000",
      "block": 16,
      "item": 0,
      "text": "— Patikrink, ar tilps.",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 2748096,
      "speechStartFrame": 2750496,
      "speechEndFrame": 2784096,
      "endFrame": 2809152,
      "start": 114.504,
      "end": 117.048,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-016-i-000.mp3"
    },
    {
      "mark": "p-017-i-000",
      "block": 17,
      "item": 0,
      "text": "Agnė pridėjo maišelį prie piešinio.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 2809152,
      "speechStartFrame": 2813952,
      "speechEndFrame": 2865552,
      "endFrame": 2878452,
      "start": 117.048,
      "end": 119.9355,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-017-i-000.mp3"
    },
    {
      "mark": "p-017-i-001",
      "block": 17,
      "item": 1,
      "text": "Patraukė vieną liniją toliau.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 2878452,
      "speechStartFrame": 2891352,
      "speechEndFrame": 2931852,
      "endFrame": 2945652,
      "start": 119.9355,
      "end": 122.7355,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-017-i-001.mp3"
    },
    {
      "mark": "p-017-i-002",
      "block": 17,
      "item": 2,
      "text": "Elzė grįžo prie paskutinio puslapio.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 2945652,
      "speechStartFrame": 2959452,
      "speechEndFrame": 3010752,
      "endFrame": 3024252,
      "start": 122.7355,
      "end": 126.0105,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-017-i-002.mp3"
    },
    {
      "mark": "p-018-i-000",
      "block": 18,
      "item": 0,
      "text": "Dukra grįžo su kaimynu.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 3024252,
      "speechStartFrame": 3037752,
      "speechEndFrame": 3072852,
      "endFrame": 3086502,
      "start": 126.0105,
      "end": 128.60425,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-018-i-000.mp3"
    },
    {
      "mark": "p-018-i-001",
      "block": 18,
      "item": 1,
      "text": "Jis su tėvu perkėlė stalą.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 3086502,
      "speechStartFrame": 3100152,
      "speechEndFrame": 3142752,
      "endFrame": 3155652,
      "start": 128.60425,
      "end": 131.4855,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-018-i-001.mp3"
    },
    {
      "mark": "p-018-i-002",
      "block": 18,
      "item": 2,
      "text": "Kėdė dabar stovėjo prie lango.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 3155652,
      "speechStartFrame": 3168552,
      "speechEndFrame": 3210852,
      "endFrame": 3224502,
      "start": 131.4855,
      "end": 134.35425,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-018-i-002.mp3"
    },
    {
      "mark": "p-018-i-003",
      "block": 18,
      "item": 3,
      "text": "Tėvas atsisėdo. Dukra atnešė jam arbatos.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 3224502,
      "speechStartFrame": 3238152,
      "speechEndFrame": 3336552,
      "endFrame": 3349452,
      "start": 134.35425,
      "end": 139.5605,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-018-i-003.mp3"
    },
    {
      "mark": "p-018-i-004",
      "block": 18,
      "item": 4,
      "text": "Darbo stalas liko prie kitos sienos.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 3349452,
      "speechStartFrame": 3362352,
      "speechEndFrame": 3418152,
      "endFrame": 3431352,
      "start": 139.5605,
      "end": 142.973,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-018-i-004.mp3"
    },
    {
      "mark": "p-019-i-000",
      "block": 19,
      "item": 0,
      "text": "Elzė užvertė knygą ir padėjo ant stalo.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 3431352,
      "speechStartFrame": 3444552,
      "speechEndFrame": 3505452,
      "endFrame": 3519402,
      "start": 142.973,
      "end": 146.64175,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-019-i-000.mp3"
    },
    {
      "mark": "p-019-i-001",
      "block": 19,
      "item": 1,
      "text": "Paimti adatą ji iš karto neskubėjo.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 3519402,
      "speechStartFrame": 3533352,
      "speechEndFrame": 3588252,
      "endFrame": 3600852,
      "start": 146.64175,
      "end": 150.0355,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-019-i-001.mp3"
    },
    {
      "mark": "p-019-i-002",
      "block": 19,
      "item": 2,
      "text": "Pirmiausia palietė seno palto kišenę.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 3600852,
      "speechStartFrame": 3613452,
      "speechEndFrame": 3666852,
      "endFrame": 3681402,
      "start": 150.0355,
      "end": 153.39175,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-019-i-002.mp3"
    },
    {
      "mark": "p-019-i-003",
      "block": 19,
      "item": 3,
      "text": "Pirštai nebedrebėjo.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 3681402,
      "speechStartFrame": 3695952,
      "speechEndFrame": 3724452,
      "endFrame": 3738852,
      "start": 153.39175,
      "end": 155.7855,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-019-i-003.mp3"
    },
    {
      "mark": "p-019-i-004",
      "block": 19,
      "item": 4,
      "text": "Elzė paėmė adatą ir įvėrė siūlą.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 3738852,
      "speechStartFrame": 3753252,
      "speechEndFrame": 3812352,
      "endFrame": 3834432,
      "start": 155.7855,
      "end": 159.768,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-019-i-004.mp3"
    },
    {
      "mark": "p-020-i-000",
      "block": 20,
      "item": 0,
      "text": "— Agne, palaikyk medžiagą.",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 3834432,
      "speechStartFrame": 3836832,
      "speechEndFrame": 3879732,
      "endFrame": 3892032,
      "start": 159.768,
      "end": 162.168,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-020-i-000.mp3"
    },
    {
      "mark": "p-020-i-001",
      "block": 20,
      "item": 1,
      "text": "Parodysiu, kaip siūti kišenę.",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 3892032,
      "speechStartFrame": 3904332,
      "speechEndFrame": 3946932,
      "endFrame": 3972096,
      "start": 162.168,
      "end": 165.504,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-020-i-001.mp3"
    },
    {
      "mark": "p-021-i-000",
      "block": 21,
      "item": 0,
      "text": "Agnė laikė medžiagą abiem rankomis.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 3972096,
      "speechStartFrame": 3976896,
      "speechEndFrame": 4027596,
      "endFrame": 4041696,
      "start": 165.504,
      "end": 168.404,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-021-i-000.mp3"
    },
    {
      "mark": "p-021-i-001",
      "block": 21,
      "item": 1,
      "text": "Elzė siuvo lėtai.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 4041696,
      "speechStartFrame": 4055796,
      "speechEndFrame": 4092996,
      "endFrame": 4106196,
      "start": 168.404,
      "end": 171.0915,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-021-i-001.mp3"
    },
    {
      "mark": "p-021-i-002",
      "block": 21,
      "item": 2,
      "text": "Adata ėjo per medžiagą",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 4106196,
      "speechStartFrame": 4119396,
      "speechEndFrame": 4151796,
      "endFrame": 4152096,
      "start": 171.0915,
      "end": 173.004,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-021-i-002.mp3"
    },
    {
      "mark": "p-021-i-003",
      "block": 21,
      "item": 3,
      "text": "ir vėl grįžo į jos ranką.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 4152096,
      "speechStartFrame": 4152396,
      "speechEndFrame": 4189296,
      "endFrame": 4212288,
      "start": 173.004,
      "end": 175.512,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-021-i-003.mp3"
    },
    {
      "mark": "p-022-i-000",
      "block": 22,
      "item": 0,
      "text": "— Dabar tu.",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 4212288,
      "speechStartFrame": 4214688,
      "speechEndFrame": 4236588,
      "endFrame": 4249938,
      "start": 175.512,
      "end": 177.08075,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-022-i-000.mp3"
    },
    {
      "mark": "p-023-i-000",
      "block": 23,
      "item": 0,
      "text": "— Bijau sugadinti.",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 4249938,
      "speechStartFrame": 4263288,
      "speechEndFrame": 4292388,
      "endFrame": 4305738,
      "start": 177.08075,
      "end": 179.40575,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-023-i-000.mp3"
    },
    {
      "mark": "p-024-i-000",
      "block": 24,
      "item": 0,
      "text": "— Tada siūk lėtai. Aš šalia.",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 4305738,
      "speechStartFrame": 4319088,
      "speechEndFrame": 4389588,
      "endFrame": 4415040,
      "start": 179.40575,
      "end": 183.96,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-024-i-000.mp3"
    },
    {
      "mark": "p-025-i-000",
      "block": 25,
      "item": 0,
      "text": "Agnė paėmė adatą.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 4415040,
      "speechStartFrame": 4420740,
      "speechEndFrame": 4454940,
      "endFrame": 4467990,
      "start": 183.96,
      "end": 186.16625,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-025-i-000.mp3"
    },
    {
      "mark": "p-025-i-001",
      "block": 25,
      "item": 1,
      "text": "Pirmą siūlę padarė per arti krašto.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 4467990,
      "speechStartFrame": 4481040,
      "speechEndFrame": 4532640,
      "endFrame": 4546590,
      "start": 186.16625,
      "end": 189.44125,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-025-i-001.mp3"
    },
    {
      "mark": "p-025-i-002",
      "block": 25,
      "item": 2,
      "text": "Elzė parodė jai kitą vietą.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 4546590,
      "speechStartFrame": 4560540,
      "speechEndFrame": 4605540,
      "endFrame": 4617990,
      "start": 189.44125,
      "end": 192.41625,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-025-i-002.mp3"
    },
    {
      "mark": "p-025-i-003",
      "block": 25,
      "item": 3,
      "text": "Adatos iš jos rankos nepaėmė.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 4617990,
      "speechStartFrame": 4630440,
      "speechEndFrame": 4676340,
      "endFrame": 4702464,
      "start": 192.41625,
      "end": 195.936,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-025-i-003.mp3"
    },
    {
      "mark": "p-026-i-000",
      "block": 26,
      "item": 0,
      "text": "— O jeigu nespėsiu?",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 4702464,
      "speechStartFrame": 4705764,
      "speechEndFrame": 4738764,
      "endFrame": 4751214,
      "start": 195.936,
      "end": 197.96725,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-026-i-000.mp3"
    },
    {
      "mark": "p-027-i-000",
      "block": 27,
      "item": 0,
      "text": "— Neskubėk. Kai vėl pavargsiu,",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 4751214,
      "speechStartFrame": 4763664,
      "speechEndFrame": 4832364,
      "endFrame": 4833414,
      "start": 197.96725,
      "end": 201.39225,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-027-i-000.mp3"
    },
    {
      "mark": "p-027-i-001",
      "block": 27,
      "item": 1,
      "text": "galėsiu laikyti medžiagą.",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 4833414,
      "speechStartFrame": 4834464,
      "speechEndFrame": 4872264,
      "endFrame": 4896000,
      "start": 201.39225,
      "end": 204.0,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-027-i-001.mp3"
    },
    {
      "mark": "p-028-i-000",
      "block": 28,
      "item": 0,
      "text": "Lina įpylė vandens į puodelius.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 4896000,
      "speechStartFrame": 4900800,
      "speechEndFrame": 4951500,
      "endFrame": 4964250,
      "start": 204.0,
      "end": 206.84375,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-028-i-000.mp3"
    },
    {
      "mark": "p-028-i-001",
      "block": 28,
      "item": 1,
      "text": "Paliko juos ant kito stalo.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 4964250,
      "speechStartFrame": 4977000,
      "speechEndFrame": 5018400,
      "endFrame": 5032050,
      "start": 206.84375,
      "end": 209.66875,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-028-i-001.mp3"
    },
    {
      "mark": "p-028-i-002",
      "block": 28,
      "item": 2,
      "text": "Šalia padėjo duonos.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 5032050,
      "speechStartFrame": 5045700,
      "speechEndFrame": 5080200,
      "endFrame": 5092800,
      "start": 209.66875,
      "end": 212.2,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-028-i-002.mp3"
    },
    {
      "mark": "p-029-i-000",
      "block": 29,
      "item": 0,
      "text": "Po dviejų valandų Elzė padėjo adatą.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 5092800,
      "speechStartFrame": 5105400,
      "speechEndFrame": 5161200,
      "endFrame": 5174100,
      "start": 212.2,
      "end": 215.5875,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-029-i-000.mp3"
    },
    {
      "mark": "p-029-i-001",
      "block": 29,
      "item": 1,
      "text": "Pirštai vėl pavargo.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 5174100,
      "speechStartFrame": 5187000,
      "speechEndFrame": 5216700,
      "endFrame": 5230350,
      "start": 215.5875,
      "end": 217.93125,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-029-i-001.mp3"
    },
    {
      "mark": "p-029-i-002",
      "block": 29,
      "item": 2,
      "text": "Ji pabandė paimti siūlą.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 5230350,
      "speechStartFrame": 5244000,
      "speechEndFrame": 5281200,
      "endFrame": 5293950,
      "start": 217.93125,
      "end": 220.58125,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-029-i-002.mp3"
    },
    {
      "mark": "p-029-i-003",
      "block": 29,
      "item": 3,
      "text": "Ranka vėl drebėjo.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 5293950,
      "speechStartFrame": 5306700,
      "speechEndFrame": 5339700,
      "endFrame": 5363712,
      "start": 220.58125,
      "end": 223.488,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-029-i-003.mp3"
    },
    {
      "mark": "p-030-i-000",
      "block": 30,
      "item": 0,
      "text": "— Pabaik kišenę.",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 5363712,
      "speechStartFrame": 5366112,
      "speechEndFrame": 5389812,
      "endFrame": 5413824,
      "start": 223.488,
      "end": 225.576,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-030-i-000.mp3"
    },
    {
      "mark": "p-031-i-000",
      "block": 31,
      "item": 0,
      "text": "Dabar Elzė laikė medžiagą, o Agnė siuvo.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 5413824,
      "speechStartFrame": 5419224,
      "speechEndFrame": 5483424,
      "endFrame": 5496324,
      "start": 225.576,
      "end": 229.0135,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-031-i-000.mp3"
    },
    {
      "mark": "p-031-i-001",
      "block": 31,
      "item": 1,
      "text": "Agnė pati baigė paskutinę siūlę.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 5496324,
      "speechStartFrame": 5509224,
      "speechEndFrame": 5556624,
      "endFrame": 5570574,
      "start": 229.0135,
      "end": 232.10725,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-031-i-001.mp3"
    },
    {
      "mark": "p-031-i-002",
      "block": 31,
      "item": 2,
      "text": "Lina pakėlė paltą. Elzė patikrino kišenę.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 5570574,
      "speechStartFrame": 5584524,
      "speechEndFrame": 5683524,
      "endFrame": 5698524,
      "start": 232.10725,
      "end": 237.4385,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-031-i-002.mp3"
    },
    {
      "mark": "p-031-i-003",
      "block": 31,
      "item": 3,
      "text": "Maišelis saldainių tilpo.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 5698524,
      "speechStartFrame": 5713524,
      "speechEndFrame": 5753124,
      "endFrame": 5776128,
      "start": 237.4385,
      "end": 240.672,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-3/p-031-i-003.mp3"
    },
    {
      "mark": "p-032-i-000",
      "block": 32,
      "item": 0,
      "text": "— Rytoj anūkui bus ko ieškoti.",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 5776128,
      "speechStartFrame": 5779128,
      "speechEndFrame": 5830428,
      "endFrame": 5853888,
      "start": 240.672,

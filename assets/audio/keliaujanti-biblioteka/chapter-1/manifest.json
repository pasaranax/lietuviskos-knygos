  "phrases": [
    {
      "mark": "p-000-i-000",
      "block": 0,
      "item": 0,
      "text": "Ryte Lina sustabdė automobilį prie akmeninio namo.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 0,
      "speechStartFrame": 4200,
      "speechEndFrame": 74100,
      "endFrame": 87900,
      "start": 0.0,
      "end": 3.6625,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-000-i-000.mp3"
    },
    {
      "mark": "p-000-i-001",
      "block": 0,
      "item": 1,
      "text": "Ant kelių gulėjo Elzės laiškas.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 87900,
      "speechStartFrame": 101700,
      "speechEndFrame": 151200,
      "endFrame": 163500,
      "start": 3.6625,
      "end": 6.8125,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-000-i-001.mp3"
    },
    {
      "mark": "p-000-i-002",
      "block": 0,
      "item": 2,
      "text": "„Ateikite anksti. Paltą reikia baigti iki rytojaus.“",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 163500,
      "speechStartFrame": 175800,
      "speechEndFrame": 276600,
      "endFrame": 289050,
      "start": 6.8125,
      "end": 12.04375,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-000-i-002.mp3"
    },
    {
      "mark": "p-001-i-000",
      "block": 1,
      "item": 0,
      "text": "Ji atidarė šonines duris.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 289050,
      "speechStartFrame": 301500,
      "speechEndFrame": 343800,
      "endFrame": 356100,
      "start": 12.04375,
      "end": 14.8375,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-001-i-000.mp3"
    },
    {
      "mark": "p-001-i-001",
      "block": 1,
      "item": 1,
      "text": "Už jų buvo didelis kambarys, pilnas knygų.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 356100,
      "speechStartFrame": 368400,
      "speechEndFrame": 429900,
      "endFrame": 442200,
      "start": 14.8375,
      "end": 18.425,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-001-i-001.mp3"
    },
    {
      "mark": "p-001-i-002",
      "block": 1,
      "item": 2,
      "text": "Lentynos siekė lubas.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 442200,
      "speechStartFrame": 454500,
      "speechEndFrame": 489000,
      "endFrame": 502050,
      "start": 18.425,
      "end": 20.91875,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-001-i-002.mp3"
    },
    {
      "mark": "p-001-i-003",
      "block": 1,
      "item": 3,
      "text": "Toliau stovėjo virtuvės stalas,",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 502050,
      "speechStartFrame": 515100,
      "speechEndFrame": 555900,
      "endFrame": 557250,
      "start": 20.91875,
      "end": 23.21875,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-001-i-003.mp3"
    },
    {
      "mark": "p-001-i-004",
      "block": 1,
      "item": 4,
      "text": "o už užuolaidos buvo Linos lova.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 557250,
      "speechStartFrame": 558600,
      "speechEndFrame": 610500,
      "endFrame": 623550,
      "start": 23.21875,
      "end": 25.98125,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-001-i-004.mp3"
    },
    {
      "mark": "p-001-i-005",
      "block": 1,
      "item": 5,
      "text": "Iš lauko automobilis atrodė visai nedidelis.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 623550,
      "speechStartFrame": 636600,
      "speechEndFrame": 700800,
      "endFrame": 714000,
      "start": 25.98125,
      "end": 29.75,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-001-i-005.mp3"
    },
    {
      "mark": "p-002-i-000",
      "block": 2,
      "item": 0,
      "text": "Elzė laukė namuose prie aukšto lango.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 714000,
      "speechStartFrame": 727200,
      "speechEndFrame": 782400,
      "endFrame": 795900,
      "start": 29.75,
      "end": 33.1625,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-002-i-000.mp3"
    },
    {
      "mark": "p-002-i-001",
      "block": 2,
      "item": 1,
      "text": "Ant stalo gulėjo tamsus paltas.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 795900,
      "speechStartFrame": 809400,
      "speechEndFrame": 858300,
      "endFrame": 870450,
      "start": 33.1625,
      "end": 36.26875,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-002-i-001.mp3"
    },
    {
      "mark": "p-002-i-002",
      "block": 2,
      "item": 2,
      "text": "Moteris paėmė adatą. Jos pirštai drebėjo.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 870450,
      "speechStartFrame": 882600,
      "speechEndFrame": 974700,
      "endFrame": 988500,
      "start": 36.26875,
      "end": 41.1875,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-002-i-002.mp3"
    },
    {
      "mark": "p-002-i-003",
      "block": 2,
      "item": 3,
      "text": "Ji bandė įverti siūlą.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 988500,
      "speechStartFrame": 1002300,
      "speechEndFrame": 1040700,
      "endFrame": 1053900,
      "start": 41.1875,
      "end": 43.9125,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-002-i-003.mp3"
    },
    {
      "mark": "p-002-i-004",
      "block": 2,
      "item": 4,
      "text": "Adata nukrito ant grindų.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 1053900,
      "speechStartFrame": 1067100,
      "speechEndFrame": 1102800,
      "endFrame": 1116300,
      "start": 43.9125,
      "end": 46.5125,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-002-i-004.mp3"
    },
    {
      "mark": "p-002-i-005",
      "block": 2,
      "item": 5,
      "text": "Lina ją pakėlė ir grąžino Elzei.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 1116300,
      "speechStartFrame": 1129800,
      "speechEndFrame": 1182600,
      "endFrame": 1196100,
      "start": 46.5125,
      "end": 49.8375,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-002-i-005.mp3"
    },
    {
      "mark": "p-002-i-006",
      "block": 2,
      "item": 6,
      "text": "Elzė paslėpė ranką po stalu.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 1196100,
      "speechStartFrame": 1209600,
      "speechEndFrame": 1258500,
      "endFrame": 1281024,
      "start": 49.8375,
      "end": 53.376,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-002-i-006.mp3"
    },
    {
      "mark": "p-003-i-000",
      "block": 3,
      "item": 0,
      "text": "— Rudenį nukritau ant laiptų.",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 1281024,
      "speechStartFrame": 1283724,
      "speechEndFrame": 1326324,
      "endFrame": 1339374,
      "start": 53.376,
      "end": 55.80725,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-003-i-000.mp3"
    },
    {
      "mark": "p-003-i-001",
      "block": 3,
      "item": 1,
      "text": "Dabar negaliu ilgai siūti.",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 1339374,
      "speechStartFrame": 1352424,
      "speechEndFrame": 1394724,
      "endFrame": 1408524,
      "start": 55.80725,
      "end": 58.6885,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-003-i-001.mp3"
    },
    {
      "mark": "p-003-i-002",
      "block": 3,
      "item": 2,
      "text": "O rytoj mano anūkas išvažiuoja.",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 1408524,
      "speechStartFrame": 1422324,
      "speechEndFrame": 1478124,
      "endFrame": 1491174,
      "start": 58.6885,
      "end": 62.13225,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-003-i-002.mp3"
    },
    {
      "mark": "p-004-i-000",
      "block": 4,
      "item": 0,
      "text": "— Ar jam reikia naujo palto?",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 1491174,
      "speechStartFrame": 1504224,
      "speechEndFrame": 1544724,
      "endFrame": 1558824,
      "start": 62.13225,
      "end": 64.951,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-004-i-000.mp3"
    },
    {
      "mark": "p-005-i-000",
      "block": 5,
      "item": 0,
      "text": "— Jis jau turi kitą.",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 1558824,
      "speechStartFrame": 1572924,
      "speechEndFrame": 1604124,
      "endFrame": 1617624,
      "start": 64.951,
      "end": 67.401,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-005-i-000.mp3"
    },
    {
      "mark": "p-005-i-001",
      "block": 5,
      "item": 1,
      "text": "Bet šitą siuvo mano vyras.",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 1617624,
      "speechStartFrame": 1631124,
      "speechEndFrame": 1673424,
      "endFrame": 1686324,
      "start": 67.401,
      "end": 70.2635,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-005-i-001.mp3"
    },
    {
      "mark": "p-005-i-002",
      "block": 5,
      "item": 2,
      "text": "Noriu pati jį paruošti kelionei.",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 1686324,
      "speechStartFrame": 1699224,
      "speechEndFrame": 1750224,
      "endFrame": 1762824,
      "start": 70.2635,
      "end": 73.451,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-005-i-002.mp3"
    },
    {
      "mark": "p-005-i-003",
      "block": 5,
      "item": 3,
      "text": "Vyras mirė prieš dvejus metus.",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 1762824,
      "speechStartFrame": 1775424,
      "speechEndFrame": 1824624,
      "endFrame": 1838424,
      "start": 73.451,
      "end": 76.601,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-005-i-003.mp3"
    },
    {
      "mark": "p-005-i-004",
      "block": 5,
      "item": 4,
      "text": "Jis visada turėjo ką nors saldaus kišenėje.",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 1838424,
      "speechStartFrame": 1852224,
      "speechEndFrame": 1919424,
      "endFrame": 1944000,
      "start": 76.601,
      "end": 81.0,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-005-i-004.mp3"
    },
    {
      "mark": "p-006-i-000",
      "block": 6,
      "item": 0,
      "text": "Prie kito stalo sėdėjo jauna mergina.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 1944000,
      "speechStartFrame": 1948800,
      "speechEndFrame": 2002500,
      "endFrame": 2015850,
      "start": 81.0,
      "end": 83.99375,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-006-i-000.mp3"
    },
    {
      "mark": "p-006-i-001",
      "block": 6,
      "item": 1,
      "text": "Agnė čia dirbo tik mėnesį.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 2015850,
      "speechStartFrame": 2029200,
      "speechEndFrame": 2070600,
      "endFrame": 2085300,
      "start": 83.99375,
      "end": 86.8875,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-006-i-001.mp3"
    },
    {
      "mark": "p-006-i-002",
      "block": 6,
      "item": 2,
      "text": "Ji padėjo siūlus ir priėjo arčiau.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 2085300,
      "speechStartFrame": 2100000,
      "speechEndFrame": 2149200,
      "endFrame": 2170944,
      "start": 86.8875,
      "end": 90.456,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-006-i-002.mp3"
    },
    {
      "mark": "p-007-i-000",
      "block": 7,
      "item": 0,
      "text": "— Aš galiu baigti paltą šiandien.",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 2170944,
      "speechStartFrame": 2173344,
      "speechEndFrame": 2217744,
      "endFrame": 2230344,
      "start": 90.456,
      "end": 92.931,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-007-i-000.mp3"
    },
    {
      "mark": "p-007-i-001",
      "block": 7,
      "item": 1,
      "text": "Jūs tik parodykite, ką daryti.",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 2230344,
      "speechStartFrame": 2242944,
      "speechEndFrame": 2290344,
      "endFrame": 2303094,
      "start": 92.931,
      "end": 95.96225,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-007-i-001.mp3"
    },
    {
      "mark": "p-008-i-000",
      "block": 8,
      "item": 0,
      "text": "— Žinau. Bet noriu pati.",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 2303094,
      "speechStartFrame": 2315844,
      "speechEndFrame": 2384844,
      "endFrame": 2409984,
      "start": 95.96225,
      "end": 100.416,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-008-i-000.mp3"
    },
    {
      "mark": "p-009-i-000",
      "block": 9,
      "item": 0,
      "text": "Elzė palietė seną palto kišenę.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 2409984,
      "speechStartFrame": 2414484,
      "speechEndFrame": 2468184,
      "endFrame": 2482884,
      "start": 100.416,
      "end": 103.4535,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-009-i-000.mp3"
    },
    {
      "mark": "p-009-i-001",
      "block": 9,
      "item": 1,
      "text": "Agnė grįžo prie savo stalo.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 2482884,
      "speechStartFrame": 2497584,
      "speechEndFrame": 2539584,
      "endFrame": 2553234,
      "start": 103.4535,
      "end": 106.38475,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-009-i-001.mp3"
    },
    {
      "mark": "p-009-i-002",
      "block": 9,
      "item": 2,
      "text": "Lina atsisėdo šalia Elzės.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 2553234,
      "speechStartFrame": 2566884,
      "speechEndFrame": 2615484,
      "endFrame": 2627934,
      "start": 106.38475,
      "end": 109.49725,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-009-i-002.mp3"
    },
    {
      "mark": "p-010-i-000",
      "block": 10,
      "item": 0,
      "text": "Lina grįžo į biblioteką ir paėmė knygą.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 2627934,
      "speechStartFrame": 2640384,
      "speechEndFrame": 2698584,
      "endFrame": 2711484,
      "start": 109.49725,
      "end": 112.9785,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-010-i-000.mp3"
    },
    {
      "mark": "p-010-i-001",
      "block": 10,
      "item": 1,
      "text": "Ant viršelio buvo medinė kėdė.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 2711484,
      "speechStartFrame": 2724384,
      "speechEndFrame": 2769084,
      "endFrame": 2784834,
      "start": 112.9785,
      "end": 116.03475,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-010-i-001.mp3"
    },
    {
      "mark": "p-010-i-002",
      "block": 10,
      "item": 2,
      "text": "Knyga vadinosi „Kėdė prie lango“.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 2784834,
      "speechStartFrame": 2800584,
      "speechEndFrame": 2848884,
      "endFrame": 2872512,
      "start": 116.03475,
      "end": 119.688,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-010-i-002.mp3"
    },
    {
      "mark": "p-011-i-000",
      "block": 11,
      "item": 0,
      "text": "— Čia vyras daro kėdę savo dukrai.",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 2872512,
      "speechStartFrame": 2874912,
      "speechEndFrame": 2923512,
      "endFrame": 2936412,
      "start": 119.688,
      "end": 122.3505,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-011-i-000.mp3"
    },
    {
      "mark": "p-011-i-001",
      "block": 11,
      "item": 1,
      "text": "Knyga gali padėti jūsų pirštams.",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 2936412,
      "speechStartFrame": 2949312,
      "speechEndFrame": 3002112,
      "endFrame": 3015012,
      "start": 122.3505,
      "end": 125.6255,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-011-i-001.mp3"
    },
    {
      "mark": "p-011-i-002",
      "block": 11,
      "item": 2,
      "text": "Bet tik kelioms valandoms.",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 3015012,
      "speechStartFrame": 3027912,
      "speechEndFrame": 3068712,
      "endFrame": 3082362,
      "start": 125.6255,
      "end": 128.43175,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-011-i-002.mp3"
    },
    {
      "mark": "p-011-i-003",
      "block": 11,
      "item": 3,
      "text": "Ją reikia perskaityti iki galo.",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 3082362,
      "speechStartFrame": 3096012,
      "speechEndFrame": 3147912,
      "endFrame": 3160962,
      "start": 128.43175,
      "end": 131.70675,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-011-i-003.mp3"
    },
    {
      "mark": "p-011-i-004",
      "block": 11,
      "item": 4,
      "text": "Paskui knygą turėsite grąžinti.",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 3160962,
      "speechStartFrame": 3174012,
      "speechEndFrame": 3222912,
      "endFrame": 3235962,
      "start": 131.70675,
      "end": 134.83175,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-011-i-004.mp3"
    },
    {
      "mark": "p-012-i-000",
      "block": 12,
      "item": 0,
      "text": "— O vyras baigia kėdę?",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 3235962,
      "speechStartFrame": 3249012,
      "speechEndFrame": 3287712,
      "endFrame": 3300612,
      "start": 134.83175,
      "end": 137.5255,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-012-i-000.mp3"
    },
    {
      "mark": "p-013-i-000",
      "block": 13,
      "item": 0,
      "text": "— Perskaitykite, tada sužinosite.",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 3300612,
      "speechStartFrame": 3313512,
      "speechEndFrame": 3366612,
      "endFrame": 3379962,
      "start": 137.5255,
      "end": 140.83175,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-013-i-000.mp3"
    },
    {
      "mark": "p-014-i-000",
      "block": 14,
      "item": 0,
      "text": "— O kiek laiko skaitysiu?",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 3379962,
      "speechStartFrame": 3393312,
      "speechEndFrame": 3432912,
      "endFrame": 3445962,
      "start": 140.83175,
      "end": 143.58175,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-014-i-000.mp3"
    },
    {
      "mark": "p-014-i-001",
      "block": 14,
      "item": 1,
      "text": "Anūkas ateis ryte pasiimti palto.",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 3445962,
      "speechStartFrame": 3459012,
      "speechEndFrame": 3511812,
      "endFrame": 3525012,
      "start": 143.58175,
      "end": 146.8755,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-014-i-001.mp3"
    },
    {
      "mark": "p-015-i-000",
      "block": 15,
      "item": 0,
      "text": "— Iki vakaro galite baigti.",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 3525012,
      "speechStartFrame": 3538212,
      "speechEndFrame": 3579012,
      "endFrame": 3591612,
      "start": 146.8755,
      "end": 149.6505,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-015-i-000.mp3"
    },
    {
      "mark": "p-015-i-001",
      "block": 15,
      "item": 1,
      "text": "Aš šiandien liksiu mieste.",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 3591612,
      "speechStartFrame": 3604212,
      "speechEndFrame": 3639312,
      "endFrame": 3664512,
      "start": 149.6505,
      "end": 152.688,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-015-i-001.mp3"
    },
    {
      "mark": "p-016-i-000",
      "block": 16,
      "item": 0,
      "text": "Ji padėjo knygą ant stalo,",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 3664512,
      "speechStartFrame": 3669012,
      "speechEndFrame": 3705912,
      "endFrame": 3707262,
      "start": 152.688,
      "end": 154.46925,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-016-i-000.mp3"
    },
    {
      "mark": "p-016-i-001",
      "block": 16,
      "item": 1,
      "text": "bet dar nepaleido.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 3707262,
      "speechStartFrame": 3708612,
      "speechEndFrame": 3734412,
      "endFrame": 3758400,
      "start": 154.46925,
      "end": 156.6,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-016-i-001.mp3"
    },
    {
      "mark": "p-017-i-000",
      "block": 17,
      "item": 0,
      "text": "— O dabar: ko galite atsisakyti?",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 3758400,
      "speechStartFrame": 3761700,
      "speechEndFrame": 3813900,
      "endFrame": 3826800,
      "start": 156.6,
      "end": 159.45,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-017-i-000.mp3"
    },
    {
      "mark": "p-018-i-000",
      "block": 18,
      "item": 0,
      "text": "— Mano siuvimo mašinos. Paimkite.",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 3826800,
      "speechStartFrame": 3839700,
      "speechEndFrame": 3916800,
      "endFrame": 3931050,
      "start": 159.45,
      "end": 163.79375,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-018-i-000.mp3"
    },
    {
      "mark": "p-018-i-001",
      "block": 18,
      "item": 1,
      "text": "Ji gera. Daug metų ja dirbau.",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 3931050,
      "speechStartFrame": 3945300,
      "speechEndFrame": 4030500,
      "endFrame": 4045200,
      "start": 163.79375,
      "end": 168.55,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-018-i-001.mp3"
    },
    {
      "mark": "p-019-i-000",
      "block": 19,
      "item": 0,
      "text": "— O kaip dirbsite rytoj?",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 4045200,
      "speechStartFrame": 4059900,
      "speechEndFrame": 4098900,
      "endFrame": 4123584,
      "start": 168.55,
      "end": 171.816,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-019-i-000.mp3"
    },
    {
      "mark": "p-020-i-000",
      "block": 20,
      "item": 0,
      "text": "Elzė pažiūrėjo į Agnę. Lina palaukė.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 4123584,
      "speechStartFrame": 4129584,
      "speechEndFrame": 4222584,
      "endFrame": 4246848,
      "start": 171.816,
      "end": 176.952,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-020-i-000.mp3"
    },
    {
      "mark": "p-021-i-000",
      "block": 21,
      "item": 0,
      "text": "— Mašinos reikia ir jai.",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 4246848,
      "speechStartFrame": 4249248,
      "speechEndFrame": 4288548,
      "endFrame": 4301148,
      "start": 176.952,
      "end": 179.2145,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-021-i-000.mp3"
    },
    {
      "mark": "p-021-i-001",
      "block": 21,
      "item": 1,
      "text": "Bet turiu savo piešinių knygą.",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 4301148,
      "speechStartFrame": 4313748,
      "speechEndFrame": 4356348,
      "endFrame": 4368798,
      "start": 179.2145,
      "end": 182.03325,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-021-i-001.mp3"
    },
    {
      "mark": "p-021-i-002",
      "block": 21,
      "item": 2,
      "text": "Pagal ją galima siūti drabužius.",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 4368798,
      "speechStartFrame": 4381248,
      "speechEndFrame": 4428048,
      "endFrame": 4440648,
      "start": 182.03325,
      "end": 185.027,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-021-i-002.mp3"
    },
    {
      "mark": "p-021-i-003",
      "block": 21,
      "item": 3,
      "text": "Iki šiol niekam jos nedaviau.",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 4440648,
      "speechStartFrame": 4453248,
      "speechEndFrame": 4500648,
      "endFrame": 4513398,
      "start": 185.027,
      "end": 188.05825,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-021-i-003.mp3"
    },
    {
      "mark": "p-021-i-004",
      "block": 21,
      "item": 4,
      "text": "Galiu ją atiduoti Agnei. Visam laikui.",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 4513398,
      "speechStartFrame": 4526148,
      "speechEndFrame": 4616748,
      "endFrame": 4641984,
      "start": 188.05825,
      "end": 193.416,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-021-i-004.mp3"
    },
    {
      "mark": "p-022-i-000",
      "block": 22,
      "item": 0,
      "text": "Elzė atidarė stalčių ir išėmė storą knygą.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 4641984,
      "speechStartFrame": 4647384,
      "speechEndFrame": 4718184,
      "endFrame": 4731084,
      "start": 193.416,
      "end": 197.1285,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-022-i-000.mp3"
    },
    {
      "mark": "p-022-i-001",
      "block": 22,
      "item": 1,
      "text": "Pirštai dar drebėjo.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 4731084,
      "speechStartFrame": 4743984,
      "speechEndFrame": 4773684,
      "endFrame": 4787334,
      "start": 197.1285,
      "end": 199.47225,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-022-i-001.mp3"
    },
    {
      "mark": "p-022-i-002",
      "block": 22,
      "item": 2,
      "text": "Ji palaikė knygą prie savęs.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 4787334,
      "speechStartFrame": 4800984,
      "speechEndFrame": 4844484,
      "endFrame": 4857084,
      "start": 199.47225,
      "end": 202.3785,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-022-i-002.mp3"
    },
    {
      "mark": "p-022-i-003",
      "block": 22,
      "item": 3,
      "text": "Agnė laukė prie stalo ir nieko nesakė.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 4857084,
      "speechStartFrame": 4869684,
      "speechEndFrame": 4927284,
      "endFrame": 4951872,
      "start": 202.3785,
      "end": 206.328,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-022-i-003.mp3"
    },
    {
      "mark": "p-023-i-000",
      "block": 23,
      "item": 0,
      "text": "— Dabar ji tavo. Gali pagal ją dirbti.",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 4951872,
      "speechStartFrame": 4954272,
      "speechEndFrame": 5044872,
      "endFrame": 5057772,
      "start": 206.328,
      "end": 210.7405,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-023-i-000.mp3"
    },
    {
      "mark": "p-024-i-000",
      "block": 24,
      "item": 0,
      "text": "— Ir ką nors pakeisti?",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 5057772,
      "speechStartFrame": 5070672,
      "speechEndFrame": 5104272,
      "endFrame": 5128128,
      "start": 210.7405,
      "end": 213.672,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-024-i-000.mp3"
    },
    {
      "mark": "p-025-i-000",
      "block": 25,
      "item": 0,
      "text": "Elzė vėl pažiūrėjo į knygą.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 5128128,
      "speechStartFrame": 5133828,
      "speechEndFrame": 5180028,
      "endFrame": 5193528,
      "start": 213.672,
      "end": 216.397,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-025-i-000.mp3"
    },
    {
      "mark": "p-025-i-001",
      "block": 25,
      "item": 1,
      "text": "Tada linktelėjo ir padėjo ją",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 5193528,
      "speechStartFrame": 5207028,
      "speechEndFrame": 5243028,
      "endFrame": 5243328,
      "start": 216.397,
      "end": 218.472,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-025-i-001.mp3"
    },
    {
      "mark": "p-025-i-002",
      "block": 25,
      "item": 2,
      "text": "prie Agnės siūlų.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 5243328,
      "speechStartFrame": 5243628,
      "speechEndFrame": 5268828,
      "endFrame": 5282328,
      "start": 218.472,
      "end": 220.097,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-025-i-002.mp3"
    },
    {
      "mark": "p-025-i-003",
      "block": 25,
      "item": 3,
      "text": "Tik tada Lina paleido savo knygą.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 5282328,
      "speechStartFrame": 5295828,
      "speechEndFrame": 5342628,
      "endFrame": 5355678,
      "start": 220.097,
      "end": 223.15325,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-025-i-003.mp3"
    },
    {
      "mark": "p-026-i-000",
      "block": 26,
      "item": 0,
      "text": "Elzė atsisėdo prie lango",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 5355678,
      "speechStartFrame": 5368728,
      "speechEndFrame": 5406528,
      "endFrame": 5406678,
      "start": 223.15325,
      "end": 225.27825,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-026-i-000.mp3"
    },
    {
      "mark": "p-026-i-001",
      "block": 26,
      "item": 1,
      "text": "ir atsivertė pirmą puslapį.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 5406678,
      "speechStartFrame": 5406828,
      "speechEndFrame": 5446428,
      "endFrame": 5459778,
      "start": 225.27825,
      "end": 227.49075,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-026-i-001.mp3"
    },
    {
      "mark": "p-026-i-002",
      "block": 26,
      "item": 2,
      "text": "Adata liko ant stalo.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 5459778,
      "speechStartFrame": 5473128,
      "speechEndFrame": 5506428,
      "endFrame": 5519928,
      "start": 227.49075,
      "end": 229.997,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-026-i-002.mp3"
    },
    {
      "mark": "p-027-i-000",
      "block": 27,
      "item": 0,
      "text": "Netrukus atėjo vyras, vardu Matas.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 5519928,
      "speechStartFrame": 5533428,
      "speechEndFrame": 5588628,
      "endFrame": 5600928,
      "start": 229.997,
      "end": 233.372,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-027-i-000.mp3"
    },
    {
      "mark": "p-027-i-001",
      "block": 27,
      "item": 1,
      "text": "Jis atnešė medžiagos paltui.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 5600928,
      "speechStartFrame": 5613228,
      "speechEndFrame": 5654328,
      "endFrame": 5667378,
      "start": 233.372,
      "end": 236.14075,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-027-i-001.mp3"
    },
    {
      "mark": "p-027-i-002",
      "block": 27,
      "item": 2,
      "text": "Lina paprašė jo pagalbos.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 5667378,
      "speechStartFrame": 5680428,
      "speechEndFrame": 5721828,
      "endFrame": 5743872,
      "start": 236.14075,
      "end": 239.328,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-027-i-002.mp3"
    },
    {
      "mark": "p-028-i-000",
      "block": 28,
      "item": 0,
      "text": "— Gal galite atnešti puodelius iš bibliotekos?",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 5743872,
      "speechStartFrame": 5746872,
      "speechEndFrame": 5814072,
      "endFrame": 5826972,
      "start": 239.328,
      "end": 242.7905,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-028-i-000.mp3"
    },
    {
      "mark": "p-028-i-001",
      "block": 28,
      "item": 1,
      "text": "Jie stovi virtuvėje, ant stalo.",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 5826972,
      "speechStartFrame": 5839872,
      "speechEndFrame": 5890272,
      "endFrame": 5914944,
      "start": 242.7905,
      "end": 246.456,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-028-i-001.mp3"
    },
    {
      "mark": "p-029-i-000",
      "block": 29,
      "item": 0,
      "text": "Matas prie durų nuvalė batus.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 5914944,
      "speechStartFrame": 5920044,
      "speechEndFrame": 5967144,
      "endFrame": 5979444,
      "start": 246.456,
      "end": 249.1435,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-029-i-000.mp3"
    },
    {
      "mark": "p-029-i-001",
      "block": 29,
      "item": 1,
      "text": "Viduje jis sustojo ir apsidairė.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 5979444,
      "speechStartFrame": 5991744,

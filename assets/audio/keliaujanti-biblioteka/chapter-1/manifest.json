    },
    {
      "mark": "p-030-i-000",
      "block": 30,
      "item": 0,
      "text": "— Jūs čia ir gyvenate?",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 6052944,
      "speechStartFrame": 6067344,
      "speechEndFrame": 6100644,
      "endFrame": 6125760,
      "start": 252.206,
      "end": 255.24,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-030-i-000.mp3"
    },
    {
      "mark": "p-031-i-000",
      "block": 31,
      "item": 0,
      "text": "— Taip. Tik puodelius vis tiek plaunu pati.",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 6125760,
      "speechStartFrame": 6130860,
      "speechEndFrame": 6220860,
      "endFrame": 6245568,
      "start": 255.24,
      "end": 260.232,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-031-i-000.mp3"
    },
    {
      "mark": "p-032-i-000",
      "block": 32,
      "item": 0,
      "text": "Matas nusijuokė. Lina parodė jam virtuvę.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 6245568,
      "speechStartFrame": 6250068,
      "speechEndFrame": 6339768,
      "endFrame": 6353418,
      "start": 260.232,
      "end": 264.72575,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-032-i-000.mp3"
    },
    {
      "mark": "p-032-i-001",
      "block": 32,
      "item": 1,
      "text": "Jis paėmė du puodelius, paskui dar vieną.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 6353418,
      "speechStartFrame": 6367068,
      "speechEndFrame": 6424668,
      "endFrame": 6438168,
      "start": 264.72575,
      "end": 268.257,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-032-i-001.mp3"
    },
    {
      "mark": "p-033-i-000",
      "block": 33,
      "item": 0,
      "text": "— Agnei irgi? — paklausė.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 6438168,
      "speechStartFrame": 6451668,
      "speechEndFrame": 6515268,
      "endFrame": 6541632,
      "start": 268.257,
      "end": 272.568,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-033-i-000.mp3"
    },
    {
      "mark": "p-034-i-000",
      "block": 34,
      "item": 0,
      "text": "— Taip.",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 6541632,
      "speechStartFrame": 6546732,
      "speechEndFrame": 6557832,
      "endFrame": 6588288,
      "start": 272.568,
      "end": 274.512,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-034-i-000.mp3"
    },
    {
      "mark": "p-035-i-000",
      "block": 35,
      "item": 0,
      "text": "Kai jie grįžo, Elzė jau skaitė.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 6588288,
      "speechStartFrame": 6593688,
      "speechEndFrame": 6642588,
      "endFrame": 6655038,
      "start": 274.512,
      "end": 277.29325,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-035-i-000.mp3"
    },
    {
      "mark": "p-035-i-001",
      "block": 35,
      "item": 1,
      "text": "Ji nepamatė puodelio šalia knygos.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 6655038,
      "speechStartFrame": 6667488,
      "speechEndFrame": 6719088,
      "endFrame": 6731838,
      "start": 277.29325,
      "end": 280.49325,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-035-i-001.mp3"
    },
    {
      "mark": "p-035-i-002",
      "block": 35,
      "item": 2,
      "text": "Lina nunešė kitą puodelį prie Agnės stalo.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 6731838,
      "speechStartFrame": 6744588,
      "speechEndFrame": 6807888,

{
  "provider": "Azure Speech",
  "sourceSha256": "6c11b447ae2669669377a36d9a02aa9418f44467ad6a5d26e5c3d09b72f4b009",
  "timingVersion": 2,
  "voiceSwitchGapSeconds": 0.0625,
  "sampleRate": 24000,
  "duration": 284.664,
  "phrases": [
    {
      "mark": "p-000-i-000",
      "block": 0,
      "item": 0,
      "text": "Ryte Lina sustabdė automobilį prie akmeninio namo.",
      "voice": "lt-LT-LeonasNeural",
      "start": 0,
      "end": 4.0625,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-000-i-000.mp3"
    },
    {
      "mark": "p-000-i-001",
      "block": 0,
      "item": 1,
      "text": "Ant kelių gulėjo Elzės laiškas.",
      "voice": "lt-LT-LeonasNeural",
      "start": 4.0625,
      "end": 7.1375,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-000-i-001.mp3"
    },
    {
      "mark": "p-000-i-002",
      "block": 0,
      "item": 2,
      "text": "„Ateikite anksti. Paltą reikia baigti iki rytojaus.“",
      "voice": "lt-LT-LeonasNeural",
      "start": 7.1375,
      "end": 12.3625,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-000-i-002.mp3"
    },
    {
      "mark": "p-001-i-000",
      "block": 1,
      "item": 0,
      "text": "Ji atidarė šonines duris.",
      "voice": "lt-LT-LeonasNeural",
      "start": 12.3625,
      "end": 15.1875,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-001-i-000.mp3"
    },
    {
      "mark": "p-001-i-001",
      "block": 1,
      "item": 1,
      "text": "Už jų buvo didelis kambarys, pilnas knygų.",
      "voice": "lt-LT-LeonasNeural",
      "start": 15.1875,
      "end": 18.7625,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-001-i-001.mp3"
    },
    {
      "mark": "p-001-i-002",
      "block": 1,
      "item": 2,
      "text": "Lentynos siekė lubas.",
      "voice": "lt-LT-LeonasNeural",
      "start": 18.7625,
      "end": 21.225,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-001-i-002.mp3"
    },
    {
      "mark": "p-001-i-003",
      "block": 1,
      "item": 3,
      "text": "Toliau stovėjo virtuvės stalas,",
      "voice": "lt-LT-LeonasNeural",
      "start": 21.225,
      "end": 23.1625,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-001-i-003.mp3"
    },
    {
      "mark": "p-001-i-004",
      "block": 1,
      "item": 4,
      "text": "o už užuolaidos buvo Linos lova.",
      "voice": "lt-LT-LeonasNeural",
      "start": 23.1625,
      "end": 26.3375,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-001-i-004.mp3"
    },
    {
      "mark": "p-001-i-005",
      "block": 1,
      "item": 5,
      "text": "Iš lauko automobilis atrodė visai nedidelis.",
      "voice": "lt-LT-LeonasNeural",
      "start": 26.3375,
      "end": 30.075,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-001-i-005.mp3"
    },
    {
      "mark": "p-002-i-000",
      "block": 2,
      "item": 0,
      "text": "Elzė laukė namuose prie aukšto lango.",
      "voice": "lt-LT-LeonasNeural",
      "start": 30.075,
      "end": 33.5375,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-002-i-000.mp3"
    },
    {
      "mark": "p-002-i-001",
      "block": 2,
      "item": 1,
      "text": "Ant stalo gulėjo tamsus paltas.",
      "voice": "lt-LT-LeonasNeural",
      "start": 33.5375,
      "end": 36.6,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-002-i-001.mp3"
    },
    {
      "mark": "p-002-i-002",
      "block": 2,
      "item": 2,
      "text": "Moteris paėmė adatą. Jos pirštai drebėjo.",
      "voice": "lt-LT-LeonasNeural",
      "start": 36.6,
      "end": 41.5375,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-002-i-002.mp3"
    },
    {
      "mark": "p-002-i-003",
      "block": 2,
      "item": 3,
      "text": "Ji bandė įverti siūlą.",
      "voice": "lt-LT-LeonasNeural",
      "start": 41.5375,
      "end": 44.2375,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-002-i-003.mp3"
    },
    {
      "mark": "p-002-i-004",
      "block": 2,
      "item": 4,
      "text": "Adata nukrito ant grindų.",
      "voice": "lt-LT-LeonasNeural",
      "start": 44.2375,
      "end": 46.9125,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-002-i-004.mp3"
    },
    {
      "mark": "p-002-i-005",
      "block": 2,
      "item": 5,
      "text": "Lina ją pakėlė ir grąžino Elzei.",
      "voice": "lt-LT-LeonasNeural",
      "start": 46.9125,
      "end": 50.2,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-002-i-005.mp3"
    },
    {
      "mark": "p-002-i-006",
      "block": 2,
      "item": 6,
      "text": "Elzė paslėpė ranką po stalu.",
      "voice": "lt-LT-LeonasNeural",
      "start": 50.2,
      "end": 53.3875,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-002-i-006.mp3"
    },
    {
      "mark": "p-003-i-000",
      "block": 3,
      "item": 0,
      "text": "— Rudenį nukritau ant laiptų.",
      "voice": "lt-LT-OnaNeural",
      "start": 53.3875,
      "end": 56.2625,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-003-i-000.mp3"
    },
    {
      "mark": "p-003-i-001",
      "block": 3,
      "item": 1,
      "text": "Dabar negaliu ilgai siūti.",
      "voice": "lt-LT-OnaNeural",
      "start": 56.2625,
      "end": 59.1625,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-003-i-001.mp3"
    },
    {
      "mark": "p-003-i-002",
      "block": 3,
      "item": 2,
      "text": "O rytoj mano anūkas išvažiuoja.",
      "voice": "lt-LT-OnaNeural",
      "start": 59.1625,
      "end": 62.575,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-003-i-002.mp3"
    },
    {
      "mark": "p-004-i-000",
      "block": 4,
      "item": 0,
      "text": "— Ar jam reikia naujo palto?",
      "voice": "lt-LT-OnaNeural",
      "start": 62.575,
      "end": 65.4125,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-004-i-000.mp3"
    },
    {
      "mark": "p-005-i-000",
      "block": 5,
      "item": 0,
      "text": "— Jis jau turi kitą.",
      "voice": "lt-LT-OnaNeural",
      "start": 65.4125,
      "end": 67.875,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-005-i-000.mp3"
    },
    {
      "mark": "p-005-i-001",
      "block": 5,
      "item": 1,
      "text": "Bet šitą siuvo mano vyras.",
      "voice": "lt-LT-OnaNeural",
      "start": 67.875,
      "end": 70.7125,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-005-i-001.mp3"
    },
    {
      "mark": "p-005-i-002",
      "block": 5,
      "item": 2,
      "text": "Noriu pati jį paruošti kelionei.",
      "voice": "lt-LT-OnaNeural",
      "start": 70.7125,
      "end": 73.8875,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-005-i-002.mp3"
    },
    {
      "mark": "p-005-i-003",
      "block": 5,
      "item": 3,
      "text": "Vyras mirė prieš dvejus metus.",
      "voice": "lt-LT-OnaNeural",
      "start": 73.8875,
      "end": 77.05,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-005-i-003.mp3"
    },
    {
      "mark": "p-005-i-004",
      "block": 5,
      "item": 4,
      "text": "Jis visada turėjo ką nors saldaus kišenėje.",
      "voice": "lt-LT-OnaNeural",
      "start": 77.05,
      "end": 81.025,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-005-i-004.mp3"
    },
    {
      "mark": "p-006-i-000",
      "block": 6,
      "item": 0,
      "text": "Prie kito stalo sėdėjo jauna mergina.",
      "voice": "lt-LT-LeonasNeural",
      "start": 81.025,
      "end": 84.4125,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-006-i-000.mp3"
    },
    {
      "mark": "p-006-i-001",
      "block": 6,
      "item": 1,
      "text": "Agnė čia dirbo tik mėnesį.",
      "voice": "lt-LT-LeonasNeural",
      "start": 84.4125,
      "end": 87.3375,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-006-i-001.mp3"
    },
    {
      "mark": "p-006-i-002",
      "block": 6,
      "item": 2,
      "text": "Ji padėjo siūlus ir priėjo arčiau.",
      "voice": "lt-LT-LeonasNeural",
      "start": 87.3375,
      "end": 90.4875,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-006-i-002.mp3"
    },
    {
      "mark": "p-007-i-000",
      "block": 7,
      "item": 0,
      "text": "— Aš galiu baigti paltą šiandien.",
      "voice": "lt-LT-OnaNeural",
      "start": 90.4875,
      "end": 93.3875,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-007-i-000.mp3"
    },
    {
      "mark": "p-007-i-001",
      "block": 7,
      "item": 1,
      "text": "Jūs tik parodykite, ką daryti.",
      "voice": "lt-LT-OnaNeural",
      "start": 93.3875,
      "end": 96.4375,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-007-i-001.mp3"
    },
    {
      "mark": "p-008-i-000",
      "block": 8,
      "item": 0,
      "text": "— Žinau. Bet noriu pati.",
      "voice": "lt-LT-OnaNeural",
      "start": 96.4375,
      "end": 100.45,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-008-i-000.mp3"
    },
    {
      "mark": "p-009-i-000",
      "block": 9,
      "item": 0,
      "text": "Elzė palietė seną palto kišenę.",
      "voice": "lt-LT-LeonasNeural",
      "start": 100.45,
      "end": 103.9,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-009-i-000.mp3"
    },
    {
      "mark": "p-009-i-001",
      "block": 9,
      "item": 1,
      "text": "Agnė grįžo prie savo stalo.",
      "voice": "lt-LT-LeonasNeural",
      "start": 103.9,
      "end": 106.825,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-009-i-001.mp3"
    },
    {
      "mark": "p-009-i-002",
      "block": 9,
      "item": 2,
      "text": "Lina atsisėdo šalia Elzės.",
      "voice": "lt-LT-LeonasNeural",
      "start": 106.825,
      "end": 109.875,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-009-i-002.mp3"
    },
    {
      "mark": "p-010-i-000",
      "block": 10,
      "item": 0,
      "text": "Lina grįžo į biblioteką ir paėmė knygą.",
      "voice": "lt-LT-LeonasNeural",
      "start": 109.875,
      "end": 113.3625,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-010-i-000.mp3"
    },
    {
      "mark": "p-010-i-001",
      "block": 10,
      "item": 1,
      "text": "Ant viršelio buvo medinė kėdė.",
      "voice": "lt-LT-LeonasNeural",
      "start": 113.3625,
      "end": 116.4875,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-010-i-001.mp3"
    },
    {
      "mark": "p-010-i-002",
      "block": 10,
      "item": 2,
      "text": "Knyga vadinosi „Kėdė prie lango“.",
      "voice": "lt-LT-LeonasNeural",
      "start": 116.4875,
      "end": 119.725,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-010-i-002.mp3"
    },
    {
      "mark": "p-011-i-000",
      "block": 11,
      "item": 0,
      "text": "— Čia vyras daro kėdę savo dukrai.",
      "voice": "lt-LT-OnaNeural",
      "start": 119.725,
      "end": 122.8,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-011-i-000.mp3"
    },
    {
      "mark": "p-011-i-001",
      "block": 11,
      "item": 1,
      "text": "Knyga gali padėti jūsų pirštams.",
      "voice": "lt-LT-OnaNeural",
      "start": 122.8,
      "end": 126.1,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-011-i-001.mp3"
    },
    {
      "mark": "p-011-i-002",
      "block": 11,
      "item": 2,
      "text": "Bet tik kelioms valandoms.",
      "voice": "lt-LT-OnaNeural",
      "start": 126.1,
      "end": 128.8875,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-011-i-002.mp3"
    },
    {
      "mark": "p-011-i-003",
      "block": 11,
      "item": 3,
      "text": "Ją reikia perskaityti iki galo.",
      "voice": "lt-LT-OnaNeural",
      "start": 128.8875,
      "end": 132.1875,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-011-i-003.mp3"
    },
    {
      "mark": "p-011-i-004",
      "block": 11,
      "item": 4,
      "text": "Paskui knygą turėsite grąžinti.",
      "voice": "lt-LT-OnaNeural",
      "start": 132.1875,
      "end": 135.275,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-011-i-004.mp3"
    },
    {
      "mark": "p-012-i-000",
      "block": 12,
      "item": 0,
      "text": "— O vyras baigia kėdę?",
      "voice": "lt-LT-OnaNeural",
      "start": 135.275,
      "end": 138.0,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-012-i-000.mp3"
    },
    {
      "mark": "p-013-i-000",
      "block": 13,
      "item": 0,
      "text": "— Perskaitykite, tada sužinosite.",
      "voice": "lt-LT-OnaNeural",
      "start": 138.0,
      "end": 141.3,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-013-i-000.mp3"
    },
    {
      "mark": "p-014-i-000",
      "block": 14,
      "item": 0,
      "text": "— O kiek laiko skaitysiu?",
      "voice": "lt-LT-OnaNeural",
      "start": 141.3,
      "end": 144.0625,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-014-i-000.mp3"
    },
    {
      "mark": "p-014-i-001",
      "block": 14,
      "item": 1,
      "text": "Anūkas ateis ryte pasiimti palto.",
      "voice": "lt-LT-OnaNeural",
      "start": 144.0625,
      "end": 147.35,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-014-i-001.mp3"
    },
    {
      "mark": "p-015-i-000",
      "block": 15,
      "item": 0,
      "text": "— Iki vakaro galite baigti.",
      "voice": "lt-LT-OnaNeural",
      "start": 147.35,
      "end": 150.1125,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-015-i-000.mp3"
    },
    {
      "mark": "p-015-i-001",
      "block": 15,
      "item": 1,
      "text": "Aš šiandien liksiu mieste.",
      "voice": "lt-LT-OnaNeural",
      "start": 150.1125,
      "end": 152.7375,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-015-i-001.mp3"
    },
    {
      "mark": "p-016-i-000",
      "block": 16,
      "item": 0,
      "text": "Ji padėjo knygą ant stalo,",
      "voice": "lt-LT-LeonasNeural",
      "start": 152.7375,
      "end": 154.4625,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-016-i-000.mp3"
    },
    {
      "mark": "p-016-i-001",
      "block": 16,
      "item": 1,
      "text": "bet dar nepaleido.",
      "voice": "lt-LT-LeonasNeural",
      "start": 154.4625,
      "end": 156.65,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-016-i-001.mp3"
    },
    {
      "mark": "p-017-i-000",
      "block": 17,
      "item": 0,
      "text": "— O dabar: ko galite atsisakyti?",
      "voice": "lt-LT-OnaNeural",
      "start": 156.65,
      "end": 159.9375,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-017-i-000.mp3"
    },
    {
      "mark": "p-018-i-000",
      "block": 18,
      "item": 0,
      "text": "— Mano siuvimo mašinos. Paimkite.",
      "voice": "lt-LT-OnaNeural",
      "start": 159.9375,
      "end": 164.3,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-018-i-000.mp3"
    },
    {
      "mark": "p-018-i-001",
      "block": 18,
      "item": 1,
      "text": "Ji gera. Daug metų ja dirbau.",
      "voice": "lt-LT-OnaNeural",
      "start": 164.3,
      "end": 168.975,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-018-i-001.mp3"
    },
    {
      "mark": "p-019-i-000",
      "block": 19,
      "item": 0,
      "text": "— O kaip dirbsite rytoj?",
      "voice": "lt-LT-OnaNeural",
      "start": 168.975,
      "end": 171.875,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-019-i-000.mp3"
    },
    {
      "mark": "p-020-i-000",
      "block": 20,
      "item": 0,
      "text": "Elzė pažiūrėjo į Agnę. Lina palaukė.",
      "voice": "lt-LT-LeonasNeural",
      "start": 171.875,
      "end": 177.025,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-020-i-000.mp3"
    },
    {
      "mark": "p-021-i-000",
      "block": 21,
      "item": 0,
      "text": "— Mašinos reikia ir jai.",
      "voice": "lt-LT-OnaNeural",
      "start": 177.025,
      "end": 179.7125,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-021-i-000.mp3"
    },
    {
      "mark": "p-021-i-001",
      "block": 21,
      "item": 1,
      "text": "Bet turiu savo piešinių knygą.",
      "voice": "lt-LT-OnaNeural",
      "start": 179.7125,
      "end": 182.525,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-021-i-001.mp3"
    },
    {
      "mark": "p-021-i-002",
      "block": 21,
      "item": 2,
      "text": "Pagal ją galima siūti drabužius.",
      "voice": "lt-LT-OnaNeural",
      "start": 182.525,
      "end": 185.5125,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-021-i-002.mp3"
    },
    {
      "mark": "p-021-i-003",
      "block": 21,
      "item": 3,
      "text": "Iki šiol niekam jos nedaviau.",
      "voice": "lt-LT-OnaNeural",
      "start": 185.5125,
      "end": 188.5625,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-021-i-003.mp3"
    },
    {
      "mark": "p-021-i-004",
      "block": 21,
      "item": 4,
      "text": "Galiu ją atiduoti Agnei. Visam laikui.",
      "voice": "lt-LT-OnaNeural",
      "start": 188.5625,
      "end": 193.5,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-021-i-004.mp3"
    },
    {
      "mark": "p-022-i-000",
      "block": 22,
      "item": 0,
      "text": "Elzė atidarė stalčių ir išėmė storą knygą.",
      "voice": "lt-LT-LeonasNeural",
      "start": 193.5,
      "end": 197.55,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-022-i-000.mp3"
    },
    {
      "mark": "p-022-i-001",
      "block": 22,
      "item": 1,
      "text": "Pirštai dar drebėjo.",
      "voice": "lt-LT-LeonasNeural",
      "start": 197.55,
      "end": 199.95,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-022-i-001.mp3"
    },
    {
      "mark": "p-022-i-002",
      "block": 22,
      "item": 2,
      "text": "Ji palaikė knygą prie savęs.",
      "voice": "lt-LT-LeonasNeural",
      "start": 199.95,
      "end": 202.7875,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-022-i-002.mp3"
    },
    {
      "mark": "p-022-i-003",
      "block": 22,
      "item": 3,
      "text": "Agnė laukė prie stalo ir nieko nesakė.",
      "voice": "lt-LT-LeonasNeural",
      "start": 202.7875,
      "end": 206.425,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-022-i-003.mp3"
    },
    {
      "mark": "p-023-i-000",
      "block": 23,
      "item": 0,
      "text": "— Dabar ji tavo. Gali pagal ją dirbti.",
      "voice": "lt-LT-OnaNeural",
      "start": 206.425,
      "end": 211.25,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-023-i-000.mp3"
    },
    {
      "mark": "p-024-i-000",
      "block": 24,
      "item": 0,
      "text": "— Ir ką nors pakeisti?",
      "voice": "lt-LT-OnaNeural",
      "start": 211.25,
      "end": 213.7625,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-024-i-000.mp3"
    },
    {
      "mark": "p-025-i-000",
      "block": 25,
      "item": 0,
      "text": "Elzė vėl pažiūrėjo į knygą.",
      "voice": "lt-LT-LeonasNeural",
      "start": 213.7625,
      "end": 216.8125,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-025-i-000.mp3"
    },
    {
      "mark": "p-025-i-001",
      "block": 25,
      "item": 1,
      "text": "Tada linktelėjo ir padėjo ją",
      "voice": "lt-LT-LeonasNeural",
      "start": 216.8125,
      "end": 218.55,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-025-i-001.mp3"
    },
    {
      "mark": "p-025-i-002",
      "block": 25,
      "item": 2,
      "text": "prie Agnės siūlų.",
      "voice": "lt-LT-LeonasNeural",
      "start": 218.55,
      "end": 220.5375,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-025-i-002.mp3"
    },
    {
      "mark": "p-025-i-003",
      "block": 25,
      "item": 3,
      "text": "Tik tada Lina paleido savo knygą.",
      "voice": "lt-LT-LeonasNeural",
      "start": 220.5375,
      "end": 223.6,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-025-i-003.mp3"
    },
    {
      "mark": "p-026-i-000",
      "block": 26,
      "item": 0,
      "text": "Elzė atsisėdo prie lango",
      "voice": "lt-LT-LeonasNeural",
      "start": 223.6,
      "end": 225.3625,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-026-i-000.mp3"
    },
    {
      "mark": "p-026-i-001",
      "block": 26,
      "item": 1,
      "text": "ir atsivertė pirmą puslapį.",
      "voice": "lt-LT-LeonasNeural",
      "start": 225.3625,
      "end": 227.95,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-026-i-001.mp3"
    },
    {
      "mark": "p-026-i-002",
      "block": 26,
      "item": 2,
      "text": "Adata liko ant stalo.",
      "voice": "lt-LT-LeonasNeural",
      "start": 227.95,
      "end": 230.45,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-026-i-002.mp3"
    },
    {
      "mark": "p-027-i-000",
      "block": 27,
      "item": 0,
      "text": "Netrukus atėjo vyras, vardu Matas.",
      "voice": "lt-LT-LeonasNeural",
      "start": 230.45,
      "end": 233.8,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-027-i-000.mp3"
    },
    {
      "mark": "p-027-i-001",
      "block": 27,
      "item": 1,
      "text": "Jis atnešė medžiagos paltui.",
      "voice": "lt-LT-LeonasNeural",
      "start": 233.8,
      "end": 236.6125,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-027-i-001.mp3"
    },
    {
      "mark": "p-027-i-002",
      "block": 27,
      "item": 2,
      "text": "Lina paprašė jo pagalbos.",
      "voice": "lt-LT-LeonasNeural",
      "start": 236.6125,
      "end": 239.4125,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-027-i-002.mp3"
    },
    {
      "mark": "p-028-i-000",
      "block": 28,
      "item": 0,
      "text": "— Gal galite atnešti puodelius iš bibliotekos?",
      "voice": "lt-LT-OnaNeural",
      "start": 239.4125,
      "end": 243.3125,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-028-i-000.mp3"
    },
    {
      "mark": "p-028-i-001",
      "block": 28,
      "item": 1,
      "text": "Jie stovi virtuvėje, ant stalo.",
      "voice": "lt-LT-OnaNeural",
      "start": 243.3125,
      "end": 246.55,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-028-i-001.mp3"
    },
    {
      "mark": "p-029-i-000",
      "block": 29,
      "item": 0,
      "text": "Matas prie durų nuvalė batus.",
      "voice": "lt-LT-LeonasNeural",
      "start": 246.55,
      "end": 249.5625,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-029-i-000.mp3"
    },
    {
      "mark": "p-029-i-001",
      "block": 29,
      "item": 1,
      "text": "Viduje jis sustojo ir apsidairė.",
      "voice": "lt-LT-LeonasNeural",
      "start": 249.5625,
      "end": 252.675,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-029-i-001.mp3"
    },
    {
      "mark": "p-030-i-000",
      "block": 30,
      "item": 0,
      "text": "— Jūs čia ir gyvenate?",
      "voice": "lt-LT-LeonasNeural",
      "start": 252.675,
      "end": 255.325,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-030-i-000.mp3"
    },
    {
      "mark": "p-031-i-000",
      "block": 31,
      "item": 0,
      "text": "— Taip. Tik puodelius vis tiek plaunu pati.",
      "voice": "lt-LT-OnaNeural",
      "start": 255.325,
      "end": 260.325,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-031-i-000.mp3"
    },
    {
      "mark": "p-032-i-000",
      "block": 32,
      "item": 0,
      "text": "Matas nusijuokė. Lina parodė jam virtuvę.",
      "voice": "lt-LT-LeonasNeural",
      "start": 260.325,
      "end": 265.225,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-032-i-000.mp3"
    },
    {
      "mark": "p-032-i-001",
      "block": 32,
      "item": 1,
      "text": "Jis paėmė du puodelius, paskui dar vieną.",
      "voice": "lt-LT-LeonasNeural",
      "start": 265.225,
      "end": 268.7375,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-032-i-001.mp3"
    },
    {
      "mark": "p-033-i-000",
      "block": 33,
      "item": 0,
      "text": "— Agnei irgi? — paklausė.",
      "voice": "lt-LT-LeonasNeural",
      "start": 268.7375,
      "end": 272.6625,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-033-i-000.mp3"
    },
    {
      "mark": "p-034-i-000",
      "block": 34,
      "item": 0,
      "text": "— Taip.",
      "voice": "lt-LT-OnaNeural",
      "start": 272.6625,
      "end": 274.6,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-034-i-000.mp3"
    },
    {
      "mark": "p-035-i-000",
      "block": 35,
      "item": 0,
      "text": "Kai jie grįžo, Elzė jau skaitė.",
      "voice": "lt-LT-LeonasNeural",
      "start": 274.6,
      "end": 277.725,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-035-i-000.mp3"
    },
    {
      "mark": "p-035-i-001",
      "block": 35,
      "item": 1,
      "text": "Ji nepamatė puodelio šalia knygos.",
      "voice": "lt-LT-LeonasNeural",
      "start": 277.725,
      "end": 280.9125,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-035-i-001.mp3"
    },
    {
      "mark": "p-035-i-002",
      "block": 35,
      "item": 2,
      "text": "Lina nunešė kitą puodelį prie Agnės stalo.",
      "voice": "lt-LT-LeonasNeural",
      "start": 280.9125,
      "end": 284.664,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-035-i-002.mp3"
    }
  ],

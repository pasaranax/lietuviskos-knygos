{
  "provider": "Azure Speech",
  "sourceSha256": "3a3a9d440f94f8b88ed6ce973d2e274ed2b2193d4773a6110b184972e76e3a24",
  "timingVersion": 2,
  "voiceSwitchGapSeconds": 0.0625,
  "sampleRate": 24000,
  "duration": 300.912,
  "phrases": [
    {
      "mark": "p-000-i-000",
      "block": 0,
      "item": 0,
      "text": "Ryte Lina sustabdė automobilį prie akmeninio namo.",
      "voice": "lt-LT-LeonasNeural",
      "start": 0,
      "end": 4.0625,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-000-i-000.mp3"
    },
    {
      "mark": "p-000-i-001",
      "block": 0,
      "item": 1,
      "text": "Ant kelių gulėjo Elzės laiškas.",
      "voice": "lt-LT-LeonasNeural",
      "start": 4.0625,
      "end": 7.1375,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-000-i-001.mp3"
    },
    {
      "mark": "p-000-i-002",
      "block": 0,
      "item": 2,
      "text": "„Ateikite anksti. Paltą reikia baigti iki rytojaus.“",
      "voice": "lt-LT-LeonasNeural",
      "start": 7.1375,
      "end": 12.3625,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-000-i-002.mp3"
    },
    {
      "mark": "p-001-i-000",
      "block": 1,
      "item": 0,
      "text": "Ji atidarė šonines duris.",
      "voice": "lt-LT-LeonasNeural",
      "start": 12.3625,
      "end": 15.1875,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-001-i-000.mp3"
    },
    {
      "mark": "p-001-i-001",
      "block": 1,
      "item": 1,
      "text": "Už jų buvo didelis kambarys, pilnas knygų.",
      "voice": "lt-LT-LeonasNeural",
      "start": 15.1875,
      "end": 18.7625,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-001-i-001.mp3"
    },
    {
      "mark": "p-001-i-002",
      "block": 1,
      "item": 2,
      "text": "Lentynos siekė lubas.",
      "voice": "lt-LT-LeonasNeural",
      "start": 18.7625,
      "end": 21.225,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-001-i-002.mp3"
    },
    {
      "mark": "p-001-i-003",
      "block": 1,
      "item": 3,
      "text": "Toliau stovėjo virtuvės stalas,",
      "voice": "lt-LT-LeonasNeural",
      "start": 21.225,
      "end": 23.1625,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-001-i-003.mp3"
    },
    {
      "mark": "p-001-i-004",
      "block": 1,
      "item": 4,
      "text": "o už užuolaidos buvo Linos lova.",
      "voice": "lt-LT-LeonasNeural",
      "start": 23.1625,
      "end": 26.3375,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-001-i-004.mp3"
    },
    {
      "mark": "p-001-i-005",
      "block": 1,
      "item": 5,
      "text": "Iš lauko automobilis atrodė visai nedidelis.",
      "voice": "lt-LT-LeonasNeural",
      "start": 26.3375,
      "end": 30.075,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-001-i-005.mp3"
    },
    {
      "mark": "p-002-i-000",
      "block": 2,
      "item": 0,
      "text": "Elzė laukė namuose prie aukšto lango.",
      "voice": "lt-LT-LeonasNeural",
      "start": 30.075,
      "end": 33.5375,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-002-i-000.mp3"
    },
    {
      "mark": "p-002-i-001",
      "block": 2,
      "item": 1,
      "text": "Ant stalo gulėjo tamsus paltas.",
      "voice": "lt-LT-LeonasNeural",
      "start": 33.5375,
      "end": 36.6,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-002-i-001.mp3"
    },
    {
      "mark": "p-002-i-002",
      "block": 2,
      "item": 2,
      "text": "Moteris paėmė adatą. Jos pirštai drebėjo.",
      "voice": "lt-LT-LeonasNeural",
      "start": 36.6,
      "end": 41.6,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-002-i-002.mp3"
    },
    {
      "mark": "p-003-i-000",
      "block": 3,
      "item": 0,
      "text": "— Rudenį nukritau ant laiptų.",
      "voice": "lt-LT-OnaNeural",
      "start": 41.6,
      "end": 44.475,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-003-i-000.mp3"
    },
    {
      "mark": "p-003-i-001",
      "block": 3,
      "item": 1,
      "text": "Dabar negaliu ilgai siūti.",
      "voice": "lt-LT-OnaNeural",
      "start": 44.475,
      "end": 47.375,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-003-i-001.mp3"
    },
    {
      "mark": "p-003-i-002",
      "block": 3,
      "item": 2,
      "text": "O rytoj mano anūkas išvažiuoja.",
      "voice": "lt-LT-OnaNeural",
      "start": 47.375,
      "end": 50.7875,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-003-i-002.mp3"
    },
    {
      "mark": "p-004-i-000",
      "block": 4,
      "item": 0,
      "text": "— Ar jam reikia naujo palto?",
      "voice": "lt-LT-OnaNeural",
      "start": 50.7875,
      "end": 53.625,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-004-i-000.mp3"
    },
    {
      "mark": "p-005-i-000",
      "block": 5,
      "item": 0,
      "text": "— Jis jau turi kitą.",
      "voice": "lt-LT-OnaNeural",
      "start": 53.625,
      "end": 56.0875,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-005-i-000.mp3"
    },
    {
      "mark": "p-005-i-001",
      "block": 5,
      "item": 1,
      "text": "Bet šitą siuvo mano vyras.",
      "voice": "lt-LT-OnaNeural",
      "start": 56.0875,
      "end": 58.925,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-005-i-001.mp3"
    },
    {
      "mark": "p-005-i-002",
      "block": 5,
      "item": 2,
      "text": "Noriu pati jį paruošti kelionei.",
      "voice": "lt-LT-OnaNeural",
      "start": 58.925,
      "end": 62.1625,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-005-i-002.mp3"
    },
    {
      "mark": "p-006-i-000",
      "block": 6,
      "item": 0,
      "text": "Lina grįžo į biblioteką ir paėmė knygą.",
      "voice": "lt-LT-LeonasNeural",
      "start": 62.1625,
      "end": 65.65,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-006-i-000.mp3"
    },
    {
      "mark": "p-006-i-001",
      "block": 6,
      "item": 1,
      "text": "Ant viršelio buvo medinė kėdė.",
      "voice": "lt-LT-LeonasNeural",
      "start": 65.65,
      "end": 68.775,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-006-i-001.mp3"
    },
    {
      "mark": "p-006-i-002",
      "block": 6,
      "item": 2,
      "text": "Knyga vadinosi „Kėdė prie lango“.",
      "voice": "lt-LT-LeonasNeural",
      "start": 68.775,
      "end": 72.0125,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-006-i-002.mp3"
    },
    {
      "mark": "p-007-i-000",
      "block": 7,
      "item": 0,
      "text": "— Čia vyras daro kėdę savo dukrai.",
      "voice": "lt-LT-OnaNeural",
      "start": 72.0125,
      "end": 75.0875,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-007-i-000.mp3"
    },
    {
      "mark": "p-007-i-001",
      "block": 7,
      "item": 1,
      "text": "Knyga gali padėti jūsų pirštams.",
      "voice": "lt-LT-OnaNeural",
      "start": 75.0875,
      "end": 78.3875,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-007-i-001.mp3"
    },
    {
      "mark": "p-007-i-002",
      "block": 7,
      "item": 2,
      "text": "Bet tik kelioms valandoms.",
      "voice": "lt-LT-OnaNeural",
      "start": 78.3875,
      "end": 81.175,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-007-i-002.mp3"
    },
    {
      "mark": "p-007-i-003",
      "block": 7,
      "item": 3,
      "text": "Ją reikia perskaityti iki galo.",
      "voice": "lt-LT-OnaNeural",
      "start": 81.175,
      "end": 84.475,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-007-i-003.mp3"
    },
    {
      "mark": "p-007-i-004",
      "block": 7,
      "item": 4,
      "text": "Paskui knygą turėsite grąžinti.",
      "voice": "lt-LT-OnaNeural",
      "start": 84.475,
      "end": 87.5625,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-007-i-004.mp3"
    },
    {
      "mark": "p-008-i-000",
      "block": 8,
      "item": 0,
      "text": "— O vyras baigia kėdę?",
      "voice": "lt-LT-OnaNeural",
      "start": 87.5625,
      "end": 90.2875,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-008-i-000.mp3"
    },
    {
      "mark": "p-009-i-000",
      "block": 9,
      "item": 0,
      "text": "— Perskaitykite, tada sužinosite.",
      "voice": "lt-LT-OnaNeural",
      "start": 90.2875,
      "end": 93.5875,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-009-i-000.mp3"
    },
    {
      "mark": "p-009-i-001",
      "block": 9,
      "item": 1,
      "text": "O dabar: ko galite atsisakyti?",
      "voice": "lt-LT-OnaNeural",
      "start": 93.5875,
      "end": 96.875,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-009-i-001.mp3"
    },
    {
      "mark": "p-010-i-000",
      "block": 10,
      "item": 0,
      "text": "— Mano siuvimo mašinos. Paimkite.",
      "voice": "lt-LT-OnaNeural",
      "start": 96.875,
      "end": 101.2375,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-010-i-000.mp3"
    },
    {
      "mark": "p-010-i-001",
      "block": 10,
      "item": 1,
      "text": "Ji gera. Daug metų ja dirbau.",
      "voice": "lt-LT-OnaNeural",
      "start": 101.2375,
      "end": 105.9125,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-010-i-001.mp3"
    },
    {
      "mark": "p-011-i-000",
      "block": 11,
      "item": 0,
      "text": "— O kaip dirbsite rytoj?",
      "voice": "lt-LT-OnaNeural",
      "start": 105.9125,
      "end": 108.8125,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-011-i-000.mp3"
    },
    {
      "mark": "p-012-i-000",
      "block": 12,
      "item": 0,
      "text": "Elzė pažiūrėjo į merginą prie stalo.",
      "voice": "lt-LT-LeonasNeural",
      "start": 108.8125,
      "end": 112.25,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-012-i-000.mp3"
    },
    {
      "mark": "p-012-i-001",
      "block": 12,
      "item": 1,
      "text": "Agnė čia dirbo tik mėnesį.",
      "voice": "lt-LT-LeonasNeural",
      "start": 112.25,
      "end": 115.175,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-012-i-001.mp3"
    },
    {
      "mark": "p-012-i-002",
      "block": 12,
      "item": 2,
      "text": "Ji tyliai dėliojo siūlus.",
      "voice": "lt-LT-LeonasNeural",
      "start": 115.175,
      "end": 117.975,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-012-i-002.mp3"
    },
    {
      "mark": "p-013-i-000",
      "block": 13,
      "item": 0,
      "text": "— Mašinos reikia ir jai,",
      "voice": "lt-LT-OnaNeural",
      "start": 117.975,
      "end": 120.8125,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-013-i-000.mp3"
    },
    {
      "mark": "p-013-i-001",
      "block": 13,
      "item": 1,
      "text": "— pagaliau pasakė Elzė.",
      "voice": "lt-LT-OnaNeural",
      "segments": [
        {
          "text": "— pagaliau pasakė Elzė.",
          "voice": "lt-LT-LeonasNeural"
        }
      ],
      "start": 120.8125,
      "end": 123.45,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-013-i-001.mp3"
    },
    {
      "mark": "p-013-i-002",
      "block": 13,
      "item": 2,
      "text": "— Bet turiu savo piešinių knygą.",
      "voice": "lt-LT-OnaNeural",
      "start": 123.45,
      "end": 126.2625,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-013-i-002.mp3"
    },
    {
      "mark": "p-013-i-003",
      "block": 13,
      "item": 3,
      "text": "Pagal ją galima siūti drabužius.",
      "voice": "lt-LT-OnaNeural",
      "start": 126.2625,
      "end": 129.25,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-013-i-003.mp3"
    },
    {
      "mark": "p-013-i-004",
      "block": 13,
      "item": 4,
      "text": "Iki šiol niekam jos nedaviau.",
      "voice": "lt-LT-OnaNeural",
      "start": 129.25,
      "end": 132.3,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-013-i-004.mp3"
    },
    {
      "mark": "p-013-i-005",
      "block": 13,
      "item": 5,
      "text": "Galiu ją atiduoti Agnei. Visam laikui.",
      "voice": "lt-LT-OnaNeural",
      "start": 132.3,
      "end": 137.2375,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-013-i-005.mp3"
    },
    {
      "mark": "p-014-i-000",
      "block": 14,
      "item": 0,
      "text": "Agnė pakėlė galvą. Lina palaukė.",
      "voice": "lt-LT-LeonasNeural",
      "start": 137.2375,
      "end": 141.675,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-014-i-000.mp3"
    },
    {
      "mark": "p-014-i-001",
      "block": 14,
      "item": 1,
      "text": "Elzė padėjo piešinių knygą prie jos siūlų.",
      "voice": "lt-LT-LeonasNeural",
      "start": 141.675,
      "end": 145.5625,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-014-i-001.mp3"
    },
    {
      "mark": "p-015-i-000",
      "block": 15,
      "item": 0,
      "text": "— Dabar ji tavo. Gali pagal ją dirbti.",
      "voice": "lt-LT-OnaNeural",
      "start": 145.5625,
      "end": 150.45,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-015-i-000.mp3"
    },
    {
      "mark": "p-016-i-000",
      "block": 16,
      "item": 0,
      "text": "Tada Elzė atsisėdo ir pradėjo skaityti.",
      "voice": "lt-LT-LeonasNeural",
      "start": 150.45,
      "end": 154.075,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-016-i-000.mp3"
    },
    {
      "mark": "p-017-i-000",
      "block": 17,
      "item": 0,
      "text": "Netrukus atėjo vyras, vardu Matas.",
      "voice": "lt-LT-LeonasNeural",
      "start": 154.075,
      "end": 157.425,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-017-i-000.mp3"
    },
    {
      "mark": "p-017-i-001",
      "block": 17,
      "item": 1,
      "text": "Jis atnešė medžiagos paltui.",
      "voice": "lt-LT-LeonasNeural",
      "start": 157.425,
      "end": 160.2375,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-017-i-001.mp3"
    },
    {
      "mark": "p-017-i-002",
      "block": 17,
      "item": 2,
      "text": "Lina paprašė jo pagalbos.",
      "voice": "lt-LT-LeonasNeural",
      "start": 160.2375,
      "end": 163.0375,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-017-i-002.mp3"
    },
    {
      "mark": "p-018-i-000",
      "block": 18,
      "item": 0,
      "text": "— Gal galite atnešti puodelius iš bibliotekos?",
      "voice": "lt-LT-OnaNeural",
      "start": 163.0375,
      "end": 166.9375,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-018-i-000.mp3"
    },
    {
      "mark": "p-018-i-001",
      "block": 18,
      "item": 1,
      "text": "Jie stovi virtuvėje, ant stalo.",
      "voice": "lt-LT-OnaNeural",
      "start": 166.9375,
      "end": 170.175,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-018-i-001.mp3"
    },
    {
      "mark": "p-019-i-000",
      "block": 19,
      "item": 0,
      "text": "Matas prie durų nuvalė batus.",
      "voice": "lt-LT-LeonasNeural",
      "start": 170.175,
      "end": 173.1875,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-019-i-000.mp3"
    },
    {
      "mark": "p-019-i-001",
      "block": 19,
      "item": 1,
      "text": "Viduje jis sustojo ir apsidairė.",
      "voice": "lt-LT-LeonasNeural",
      "start": 173.1875,
      "end": 176.3,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-019-i-001.mp3"
    },
    {
      "mark": "p-020-i-000",
      "block": 20,
      "item": 0,
      "text": "— Jūs čia ir gyvenate?",
      "voice": "lt-LT-LeonasNeural",
      "start": 176.3,
      "end": 178.95,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-020-i-000.mp3"
    },
    {
      "mark": "p-021-i-000",
      "block": 21,
      "item": 0,
      "text": "— Taip. Tik puodelius vis tiek plaunu pati.",
      "voice": "lt-LT-OnaNeural",
      "start": 178.95,
      "end": 183.95,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-021-i-000.mp3"
    },
    {
      "mark": "p-022-i-000",
      "block": 22,
      "item": 0,
      "text": "Matas nusijuokė. Lina parodė jam virtuvę.",
      "voice": "lt-LT-LeonasNeural",
      "start": 183.95,
      "end": 188.85,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-022-i-000.mp3"
    },
    {
      "mark": "p-022-i-001",
      "block": 22,
      "item": 1,
      "text": "Jis paėmė puodelius ir grįžo pas Elzę.",
      "voice": "lt-LT-LeonasNeural",
      "start": 188.85,
      "end": 192.375,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-022-i-001.mp3"
    },
    {
      "mark": "p-022-i-002",
      "block": 22,
      "item": 2,
      "text": "Vėliau ji nuėjo į turgų.",
      "voice": "lt-LT-LeonasNeural",
      "start": 192.375,
      "end": 195.1375,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-022-i-002.mp3"
    },
    {
      "mark": "p-022-i-003",
      "block": 22,
      "item": 3,
      "text": "Nupirko duonos ir juodų siūlų Elzei.",
      "voice": "lt-LT-LeonasNeural",
      "start": 195.1375,
      "end": 198.725,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-022-i-003.mp3"
    },
    {
      "mark": "p-023-i-000",
      "block": 23,
      "item": 0,
      "text": "Elzė skaitė beveik penkias valandas.",
      "voice": "lt-LT-LeonasNeural",
      "start": 198.725,
      "end": 202.1125,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-023-i-000.mp3"
    },
    {
      "mark": "p-023-i-001",
      "block": 23,
      "item": 1,
      "text": "Vieną puslapį ji perskaitė du kartus.",
      "voice": "lt-LT-LeonasNeural",
      "start": 202.1125,
      "end": 205.4375,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-023-i-001.mp3"
    },
    {
      "mark": "p-023-i-002",
      "block": 23,
      "item": 2,
      "text": "Knygoje vyras ieškojo vietos naujai kėdei.",
      "voice": "lt-LT-LeonasNeural",
      "start": 205.4375,
      "end": 209.2,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-023-i-002.mp3"
    },
    {
      "mark": "p-024-i-000",
      "block": 24,
      "item": 0,
      "text": "„Padėk ją prie lango, tėti“,",
      "voice": "lt-LT-OnaNeural",
      "start": 209.2,
      "end": 212.3,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-024-i-000.mp3"
    },
    {
      "mark": "p-024-i-001",
      "block": 24,
      "item": 1,
      "text": "— prašė dukra.",
      "voice": "lt-LT-OnaNeural",
      "segments": [
        {
          "text": "— prašė dukra.",
          "voice": "lt-LT-LeonasNeural"
        }
      ],
      "start": 212.3,
      "end": 214.35,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-024-i-001.mp3"
    },
    {
      "mark": "p-025-i-000",
      "block": 25,
      "item": 0,
      "text": "Bet ten stovėjo sunkus darbo stalas.",
      "voice": "lt-LT-LeonasNeural",
      "start": 214.35,
      "end": 217.6625,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-025-i-000.mp3"
    },
    {
      "mark": "p-025-i-001",
      "block": 25,
      "item": 1,
      "text": "Vyras negalėjo jo perkelti vienas.",
      "voice": "lt-LT-LeonasNeural",
      "start": 217.6625,
      "end": 220.9,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-025-i-001.mp3"
    },
    {
      "mark": "p-025-i-002",
      "block": 25,
      "item": 2,
      "text": "Dukra pasikvietė jauną kaimyną.",
      "voice": "lt-LT-LeonasNeural",
      "start": 220.9,
      "end": 223.8625,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-025-i-002.mp3"
    },
    {
      "mark": "p-025-i-003",
      "block": 25,
      "item": 3,
      "text": "Jis padėjo, ir prie lango atsirado vietos.",
      "voice": "lt-LT-LeonasNeural",
      "start": 223.8625,
      "end": 227.4,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-025-i-003.mp3"
    },
    {
      "mark": "p-026-i-000",
      "block": 26,
      "item": 0,
      "text": "Elzė perskaitė paskutinį puslapį ir užvertė knygą.",
      "voice": "lt-LT-LeonasNeural",
      "start": 227.4,
      "end": 231.775,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-026-i-000.mp3"
    },
    {
      "mark": "p-026-i-001",
      "block": 26,
      "item": 1,
      "text": "Kurį laiką ji laikė knygą ant kelių.",
      "voice": "lt-LT-LeonasNeural",
      "start": 231.775,
      "end": 235.0375,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-026-i-001.mp3"
    },
    {
      "mark": "p-026-i-002",
      "block": 26,
      "item": 2,
      "text": "Paskui paėmė adatą. Pirštai nebedrebėjo.",
      "voice": "lt-LT-LeonasNeural",
      "start": 235.0375,
      "end": 239.7375,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-026-i-002.mp3"
    },
    {
      "mark": "p-026-i-003",
      "block": 26,
      "item": 3,
      "text": "Ji įvėrė siūlą į adatą.",
      "voice": "lt-LT-LeonasNeural",
      "start": 239.7375,
      "end": 242.6,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-026-i-003.mp3"
    },
    {
      "mark": "p-026-i-004",
      "block": 26,
      "item": 4,
      "text": "Tada palietė seną palto kišenę.",
      "voice": "lt-LT-LeonasNeural",
      "start": 242.6,
      "end": 245.9125,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-026-i-004.mp3"
    },
    {
      "mark": "p-027-i-000",
      "block": 27,
      "item": 0,
      "text": "— Agne, palaikyk medžiagą. Parodysiu, kaip siūti.",
      "voice": "lt-LT-OnaNeural",
      "start": 245.9125,
      "end": 251.1875,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-027-i-000.mp3"
    },
    {
      "mark": "p-027-i-001",
      "block": 27,
      "item": 1,
      "text": "O rytoj pati galėsi taip dirbti.",
      "voice": "lt-LT-OnaNeural",
      "start": 251.1875,
      "end": 254.4375,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-027-i-001.mp3"
    },
    {
      "mark": "p-028-i-000",
      "block": 28,
      "item": 0,
      "text": "Agnė laikė medžiagą, o Elzė siuvo.",
      "voice": "lt-LT-LeonasNeural",
      "start": 254.4375,
      "end": 257.85,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-028-i-000.mp3"
    },
    {
      "mark": "p-028-i-001",
      "block": 28,
      "item": 1,
      "text": "Kartą Elzė paprašė atsiversti piešinių knygą.",
      "voice": "lt-LT-LeonasNeural",
      "start": 257.85,
      "end": 261.8125,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-028-i-001.mp3"
    },
    {
      "mark": "p-028-i-002",
      "block": 28,
      "item": 2,
      "text": "Agnė dabar galėjo ją imti be leidimo.",
      "voice": "lt-LT-LeonasNeural",
      "start": 261.8125,
      "end": 265.3,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-028-i-002.mp3"
    },
    {
      "mark": "p-029-i-000",
      "block": 29,
      "item": 0,
      "text": "Po dviejų valandų pirštai vėl pavargo.",
      "voice": "lt-LT-LeonasNeural",
      "start": 265.3,
      "end": 268.45,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-029-i-000.mp3"
    },
    {
      "mark": "p-029-i-001",
      "block": 29,
      "item": 1,
      "text": "Bet paltas jau buvo baigtas.",
      "voice": "lt-LT-LeonasNeural",
      "start": 268.45,
      "end": 271.2125,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-029-i-001.mp3"
    },
    {
      "mark": "p-029-i-002",
      "block": 29,
      "item": 2,
      "text": "Elzė grąžino Linai knygą su kėde.",
      "voice": "lt-LT-LeonasNeural",
      "start": 271.2125,
      "end": 274.6375,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-029-i-002.mp3"
    },
    {
      "mark": "p-029-i-003",
      "block": 29,
      "item": 3,
      "text": "Už kelionę ji sumokėjo atskirai.",
      "voice": "lt-LT-LeonasNeural",
      "start": 274.6375,
      "end": 277.6625,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-029-i-003.mp3"
    },
    {
      "mark": "p-030-i-000",
      "block": 30,
      "item": 0,
      "text": "Bibliotekoje Lina apžiūrėjo viršelį ir puslapius.",
      "voice": "lt-LT-LeonasNeural",
      "start": 277.6625,
      "end": 281.6,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-030-i-000.mp3"
    },
    {
      "mark": "p-030-i-001",
      "block": 30,
      "item": 1,
      "text": "Padėjo knygą į jos vietą lentynoje.",
      "voice": "lt-LT-LeonasNeural",
      "start": 281.6,
      "end": 284.875,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-030-i-001.mp3"
    },
    {
      "mark": "p-030-i-002",
      "block": 30,
      "item": 2,
      "text": "Vakare Matas grįžo iš miesto.",
      "voice": "lt-LT-LeonasNeural",
      "start": 284.875,
      "end": 287.825,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-030-i-002.mp3"
    },
    {
      "mark": "p-030-i-003",
      "block": 30,
      "item": 3,
      "text": "Prie durų jos laukė Matas.",
      "voice": "lt-LT-LeonasNeural",
      "start": 287.825,
      "end": 290.625,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-030-i-003.mp3"
    },
    {
      "mark": "p-031-i-000",
      "block": 31,
      "item": 0,
      "text": "— Ar jūsų knygos padeda rasti kelią?",
      "voice": "lt-LT-LeonasNeural",
      "start": 290.625,
      "end": 293.925,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-031-i-000.mp3"
    },
    {
      "mark": "p-032-i-000",
      "block": 32,
      "item": 0,
      "text": "Lina parodė jam kėdę prie virtuvės stalo.",
      "voice": "lt-LT-LeonasNeural",
      "start": 293.925,
      "end": 297.5625,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-032-i-000.mp3"
    },
    {
      "mark": "p-033-i-000",
      "block": 33,
      "item": 0,
      "text": "— Papasakokite, kur norite nuvažiuoti.",
      "voice": "lt-LT-OnaNeural",
      "start": 297.5625,
      "end": 300.912,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-1/p-033-i-000.mp3"
    }
  ],

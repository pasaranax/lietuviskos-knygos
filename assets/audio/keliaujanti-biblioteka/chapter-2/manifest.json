  "phrases": [
    {
      "mark": "p-000-i-000",
      "block": 0,
      "item": 0,
      "text": "Elzė skaitė prie lango.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 0,
      "speechStartFrame": 5700,
      "speechEndFrame": 44400,
      "endFrame": 57300,
      "start": 0.0,
      "end": 2.3875,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-000-i-000.mp3"
    },
    {
      "mark": "p-000-i-001",
      "block": 0,
      "item": 1,
      "text": "Agnė ištiesė medžiagą ant stalo.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 57300,
      "speechStartFrame": 70200,
      "speechEndFrame": 117600,
      "endFrame": 130200,
      "start": 2.3875,
      "end": 5.425,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-000-i-001.mp3"
    },
    {
      "mark": "p-000-i-002",
      "block": 0,
      "item": 2,
      "text": "Prie jos gulėjo piešinių knyga.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 130200,
      "speechStartFrame": 142800,
      "speechEndFrame": 186600,
      "endFrame": 209664,
      "start": 5.425,
      "end": 8.736,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-000-i-002.mp3"
    },
    {
      "mark": "p-001-i-000",
      "block": 1,
      "item": 0,
      "text": "— Juodų siūlų beveik nebeliko.",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 209664,
      "speechStartFrame": 212064,
      "speechEndFrame": 255564,
      "endFrame": 268314,
      "start": 8.736,
      "end": 11.17975,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-001-i-000.mp3"
    },
    {
      "mark": "p-001-i-001",
      "block": 1,
      "item": 1,
      "text": "Ar galite nupirkti? Parduotuvė prie aikštės.",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 268314,
      "speechStartFrame": 281064,
      "speechEndFrame": 377064,
      "endFrame": 389664,
      "start": 11.17975,
      "end": 16.236,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-001-i-001.mp3"
    },
    {
      "mark": "p-002-i-000",
      "block": 2,
      "item": 0,
      "text": "— Galiu. Ir duonos atnešiu.",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 389664,
      "speechStartFrame": 402264,
      "speechEndFrame": 477264,
      "endFrame": 502848,
      "start": 16.236,
      "end": 20.952,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-002-i-000.mp3"
    },
    {
      "mark": "p-003-i-000",
      "block": 3,
      "item": 0,
      "text": "— Aš einu į tą pačią pusę.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 502848,
      "speechStartFrame": 507648,
      "speechEndFrame": 543948,
      "endFrame": 558498,
      "start": 20.952,
      "end": 23.27075,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-003-i-000.mp3"
    },
    {
      "mark": "p-003-i-001",
      "block": 3,
      "item": 1,
      "text": "Galime eiti kartu.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 558498,
      "speechStartFrame": 573048,
      "speechEndFrame": 603648,
      "endFrame": 617298,
      "start": 23.27075,
      "end": 25.72075,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-003-i-001.mp3"
    },
    {
      "mark": "p-004-i-000",
      "block": 4,
      "item": 0,
      "text": "Ardavoje jie ėjo aukštyn akmenine gatve.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 617298,
      "speechStartFrame": 630948,
      "speechEndFrame": 692148,
      "endFrame": 705948,
      "start": 25.72075,
      "end": 29.4145,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-004-i-000.mp3"
    },
    {
      "mark": "p-004-i-001",
      "block": 4,
      "item": 1,
      "text": "Nuo kalvos matėsi miesto stogai.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 705948,
      "speechStartFrame": 719748,
      "speechEndFrame": 768348,
      "endFrame": 781548,
      "start": 29.4145,
      "end": 32.5645,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-004-i-001.mp3"
    },
    {
      "mark": "p-004-i-002",
      "block": 4,
      "item": 2,
      "text": "Prie duonos parduotuvės Matas sustojo.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 781548,
      "speechStartFrame": 794748,
      "speechEndFrame": 847848,
      "endFrame": 861648,
      "start": 32.5645,
      "end": 35.902,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-004-i-002.mp3"
    },
    {
      "mark": "p-005-i-000",
      "block": 5,
      "item": 0,
      "text": "— Ar turite knygą,",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 861648,
      "speechStartFrame": 875448,
      "speechEndFrame": 897348,
      "endFrame": 898548,
      "start": 35.902,
      "end": 37.4395,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-005-i-000.mp3"
    },
    {
      "mark": "p-005-i-001",
      "block": 5,
      "item": 1,
      "text": "kuri padeda rasti žmogų?",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 898548,
      "speechStartFrame": 899748,
      "speechEndFrame": 937248,
      "endFrame": 960192,
      "start": 37.4395,
      "end": 40.008,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-005-i-001.mp3"
    },
    {
      "mark": "p-006-i-000",
      "block": 6,
      "item": 0,
      "text": "— Ko ieškote?",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 960192,
      "speechStartFrame": 962592,
      "speechEndFrame": 986292,
      "endFrame": 1010304,
      "start": 40.008,
      "end": 42.096,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-006-i-000.mp3"
    },
    {
      "mark": "p-007-i-000",
      "block": 7,
      "item": 0,
      "text": "— Mano sesers Noros.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 1010304,
      "speechStartFrame": 1015104,
      "speechEndFrame": 1048104,
      "endFrame": 1061154,
      "start": 42.096,
      "end": 44.21475,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-007-i-000.mp3"
    },
    {
      "mark": "p-007-i-001",
      "block": 7,
      "item": 1,
      "text": "Ji gyvena Tilvene. Bent jau taip rašo.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 1061154,
      "speechStartFrame": 1074204,
      "speechEndFrame": 1168704,
      "endFrame": 1181454,
      "start": 44.21475,
      "end": 49.22725,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-007-i-001.mp3"
    },
    {
      "mark": "p-008-i-000",
      "block": 8,
      "item": 0,
      "text": "Iš krepšio jis išėmė mažą sąsiuvinį.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 1181454,
      "speechStartFrame": 1194204,
      "speechEndFrame": 1253004,
      "endFrame": 1266504,
      "start": 49.22725,
      "end": 52.771,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-008-i-000.mp3"
    },
    {
      "mark": "p-008-i-001",
      "block": 8,
      "item": 1,
      "text": "Atvertė puslapį ir parodė Linai.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 1266504,
      "speechStartFrame": 1280004,
      "speechEndFrame": 1326804,
      "endFrame": 1339704,
      "start": 52.771,
      "end": 55.821,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-008-i-001.mp3"
    },
    {
      "mark": "p-009-i-000",
      "block": 9,
      "item": 0,
      "text": "— Mes turime du tokius sąsiuvinius.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 1339704,
      "speechStartFrame": 1352604,
      "speechEndFrame": 1400904,
      "endFrame": 1414104,
      "start": 55.821,
      "end": 58.921,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-009-i-000.mp3"
    },
    {
      "mark": "p-009-i-001",
      "block": 9,
      "item": 1,
      "text": "Kai sesuo rašo savo sąsiuvinyje,",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 1414104,
      "speechStartFrame": 1427304,
      "speechEndFrame": 1474704,
      "endFrame": 1476054,
      "start": 58.921,
      "end": 61.50225,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-009-i-001.mp3"
    },
    {
      "mark": "p-009-i-002",
      "block": 9,
      "item": 2,
      "text": "žodžiai atsiranda ir čia.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 1476054,
      "speechStartFrame": 1477404,
      "speechEndFrame": 1512504,
      "endFrame": 1526304,
      "start": 61.50225,
      "end": 63.596,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-009-i-002.mp3"
    },
    {
      "mark": "p-009-i-003",
      "block": 9,
      "item": 3,
      "text": "Ir atvirkščiai. Anksčiau abu perskaitėme",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 1526304,
      "speechStartFrame": 1540104,
      "speechEndFrame": 1625304,
      "endFrame": 1625604,
      "start": 63.596,
      "end": 67.7335,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-009-i-003.mp3"
    },
    {
      "mark": "p-009-i-004",
      "block": 9,
      "item": 4,
      "text": "tą pačią knygą.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 1625604,
      "speechStartFrame": 1625904,
      "speechEndFrame": 1649304,
      "endFrame": 1662504,
      "start": 67.7335,
      "end": 69.271,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-009-i-004.mp3"
    },
    {
      "mark": "p-009-i-005",
      "block": 9,
      "item": 5,
      "text": "Nuo tada galime taip kalbėtis.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 1662504,
      "speechStartFrame": 1675704,
      "speechEndFrame": 1718604,
      "endFrame": 1731204,
      "start": 69.271,
      "end": 72.1335,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-009-i-005.mp3"
    },
    {
      "mark": "p-010-i-000",
      "block": 10,
      "item": 0,
      "text": "Ant puslapio buvo adresas:",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 1731204,
      "speechStartFrame": 1743804,
      "speechEndFrame": 1784004,
      "endFrame": 1785654,
      "start": 72.1335,
      "end": 74.40225,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-010-i-000.mp3"
    },
    {
      "mark": "p-010-i-001",
      "block": 10,
      "item": 1,
      "text": "„Tilvenas, Sodų gatvė, 12.“",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 1785654,
      "speechStartFrame": 1787304,
      "speechEndFrame": 1836804,
      "endFrame": 1849404,
      "start": 74.40225,
      "end": 77.0585,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-010-i-001.mp3"
    },
    {
      "mark": "p-010-i-002",
      "block": 10,
      "item": 2,
      "text": "Po juo Nora rašė apie sriubą.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 1849404,
      "speechStartFrame": 1862004,
      "speechEndFrame": 1907904,
      "endFrame": 1930176,
      "start": 77.0585,
      "end": 80.424,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-010-i-002.mp3"
    },
    {
      "mark": "p-011-i-000",
      "block": 11,
      "item": 0,
      "text": "„Lauke šalta. Kaimynė atnešė bulvių.",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 1930176,
      "speechStartFrame": 1932576,
      "speechEndFrame": 2018076,
      "endFrame": 2030826,
      "start": 80.424,
      "end": 84.61775,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-011-i-000.mp3"
    },
    {
      "mark": "p-011-i-001",
      "block": 11,
      "item": 1,
      "text": "Man nieko netrūksta.",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 2030826,
      "speechStartFrame": 2043576,
      "speechEndFrame": 2075376,
      "endFrame": 2088126,
      "start": 84.61775,
      "end": 87.00525,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-011-i-001.mp3"
    },
    {
      "mark": "p-011-i-002",
      "block": 11,
      "item": 2,
      "text": "Parašyk, kur šiandien esi.“",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 2088126,
      "speechStartFrame": 2100876,
      "speechEndFrame": 2140476,
      "endFrame": 2165760,
      "start": 87.00525,
      "end": 90.24,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-011-i-002.mp3"
    },
    {
      "mark": "p-012-i-000",
      "block": 12,
      "item": 0,
      "text": "— Aš buvau toje gatvėje.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 2165760,
      "speechStartFrame": 2170560,
      "speechEndFrame": 2203560,
      "endFrame": 2217510,
      "start": 90.24,
      "end": 92.39625,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-012-i-000.mp3"
    },
    {
      "mark": "p-012-i-001",
      "block": 12,
      "item": 1,
      "text": "Dabar ten yra aikštė. Namo nėra.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 2217510,
      "speechStartFrame": 2231460,
      "speechEndFrame": 2316660,
      "endFrame": 2331510,
      "start": 92.39625,
      "end": 97.14625,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-012-i-001.mp3"
    },
    {
      "mark": "p-012-i-002",
      "block": 12,
      "item": 2,
      "text": "Žmonės sako, kad Sodų gatvės",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 2331510,
      "speechStartFrame": 2346360,
      "speechEndFrame": 2389260,
      "endFrame": 2389560,
      "start": 97.14625,
      "end": 99.565,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-012-i-002.mp3"
    },
    {
      "mark": "p-012-i-003",
      "block": 12,
      "item": 3,
      "text": "jau daug metų nėra.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 2389560,
      "speechStartFrame": 2389860,
      "speechEndFrame": 2418960,
      "endFrame": 2443392,
      "start": 99.565,
      "end": 101.808,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-012-i-003.mp3"
    },
    {
      "mark": "p-013-i-000",
      "block": 13,
      "item": 0,
      "text": "— Gal gatvė gavo kitą vardą?",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 2443392,
      "speechStartFrame": 2446392,
      "speechEndFrame": 2488992,
      "endFrame": 2513664,
      "start": 101.808,
      "end": 104.736,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-013-i-000.mp3"
    },
    {
      "mark": "p-014-i-000",
      "block": 14,
      "item": 0,
      "text": "— Patikrinau. Nora parašė, kaip ateiti",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 2513664,
      "speechStartFrame": 2516664,
      "speechEndFrame": 2594664,
      "endFrame": 2594964,
      "start": 104.736,
      "end": 108.1235,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-014-i-000.mp3"
    },
    {
      "mark": "p-014-i-001",
      "block": 14,
      "item": 1,
      "text": "nuo stoties iki jos namo.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 2594964,
      "speechStartFrame": 2595264,
      "speechEndFrame": 2634864,
      "endFrame": 2649114,
      "start": 108.1235,
      "end": 110.37975,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-014-i-001.mp3"
    },
    {
      "mark": "p-014-i-002",
      "block": 14,
      "item": 2,
      "text": "Ėjau tuo keliu kelis kartus.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 2649114,
      "speechStartFrame": 2663364,
      "speechEndFrame": 2705064,
      "endFrame": 2717814,
      "start": 110.37975,
      "end": 113.24225,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-014-i-002.mp3"
    },
    {
      "mark": "p-014-i-003",
      "block": 14,
      "item": 3,
      "text": "Vis tiek radau aikštę.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 2717814,
      "speechStartFrame": 2730564,
      "speechEndFrame": 2763564,
      "endFrame": 2787264,
      "start": 113.24225,
      "end": 116.136,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-014-i-003.mp3"
    },
    {
      "mark": "p-015-i-000",
      "block": 15,
      "item": 0,
      "text": "— O ji gali išeiti?",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 2787264,
      "speechStartFrame": 2790864,
      "speechEndFrame": 2824764,
      "endFrame": 2849472,
      "start": 116.136,
      "end": 118.728,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-015-i-000.mp3"
    },
    {
      "mark": "p-016-i-000",
      "block": 16,
      "item": 0,
      "text": "— Bandė eiti į stotį.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 2849472,
      "speechStartFrame": 2854272,
      "speechEndFrame": 2889372,
      "endFrame": 2903622,
      "start": 118.728,
      "end": 120.98425,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-016-i-000.mp3"
    },
    {
      "mark": "p-016-i-001",
      "block": 16,
      "item": 1,
      "text": "Gatvės gale vėl pamatė savo namą.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 2903622,
      "speechStartFrame": 2917872,
      "speechEndFrame": 2969472,
      "endFrame": 2983272,
      "start": 120.98425,
      "end": 124.303,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-016-i-001.mp3"
    },
    {
      "mark": "p-016-i-002",
      "block": 16,
      "item": 2,
      "text": "Net kai ėjo tiesiai.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 2983272,
      "speechStartFrame": 2997072,
      "speechEndFrame": 3030072,
      "endFrame": 3052800,
      "start": 124.303,
      "end": 127.2,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-016-i-002.mp3"
    },
    {
      "mark": "p-017-i-000",
      "block": 17,
      "item": 0,
      "text": "— Kiek laiko jos ieškote?",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 3052800,
      "speechStartFrame": 3055200,
      "speechEndFrame": 3094800,
      "endFrame": 3118464,
      "start": 127.2,
      "end": 129.936,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-017-i-000.mp3"
    },
    {
      "mark": "p-018-i-000",
      "block": 18,
      "item": 0,
      "text": "— Trečią savaitę. Rašau beveik kasdien.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 3118464,
      "speechStartFrame": 3124764,
      "speechEndFrame": 3208764,
      "endFrame": 3221664,
      "start": 129.936,
      "end": 134.236,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-018-i-000.mp3"
    },
    {
      "mark": "p-018-i-001",
      "block": 18,
      "item": 1,
      "text": "Ji nesupranta, kodėl neateinu.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 3221664,
      "speechStartFrame": 3234564,
      "speechEndFrame": 3277764,
      "endFrame": 3291414,
      "start": 134.236,
      "end": 137.14225,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-018-i-001.mp3"
    },
    {
      "mark": "p-019-i-000",
      "block": 19,
      "item": 0,
      "text": "Po adresu atsirado nauja eilutė:",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 3291414,
      "speechStartFrame": 3305064,
      "speechEndFrame": 3352464,
      "endFrame": 3354714,
      "start": 137.14225,
      "end": 139.77975,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-019-i-000.mp3"
    },
    {
      "mark": "p-019-i-001",
      "block": 19,
      "item": 1,
      "text": "„Ar jau pavalgei?“",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 3354714,
      "speechStartFrame": 3356964,
      "speechEndFrame": 3382164,
      "endFrame": 3394914,
      "start": 139.77975,
      "end": 141.45475,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-019-i-001.mp3"
    },
    {
      "mark": "p-019-i-002",
      "block": 19,
      "item": 2,
      "text": "Matas paėmė pieštuką.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 3394914,
      "speechStartFrame": 3407664,
      "speechEndFrame": 3443064,
      "endFrame": 3456414,
      "start": 141.45475,
      "end": 144.01725,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-019-i-002.mp3"
    },
    {
      "mark": "p-019-i-003",
      "block": 19,
      "item": 3,
      "text": "Jis norėjo parašyti, kad vėl nerado gatvės.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 3456414,
      "speechStartFrame": 3469764,
      "speechEndFrame": 3533364,
      "endFrame": 3546114,
      "start": 144.01725,
      "end": 147.75475,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-019-i-003.mp3"
    },
    {
      "mark": "p-019-i-004",
      "block": 19,
      "item": 4,
      "text": "Bet sustojo. Nora tai jau žinojo.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 3546114,
      "speechStartFrame": 3558864,
      "speechEndFrame": 3644064,
      "endFrame": 3658014,
      "start": 147.75475,
      "end": 152.41725,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-019-i-004.mp3"
    },
    {
      "mark": "p-019-i-005",
      "block": 19,
      "item": 5,
      "text": "Tada parašė:",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 3658014,
      "speechStartFrame": 3671964,
      "speechEndFrame": 3691164,
      "endFrame": 3692814,
      "start": 152.41725,
      "end": 153.86725,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-019-i-005.mp3"
    },
    {
      "mark": "p-019-i-006",
      "block": 19,
      "item": 6,
      "text": "„Dabar valgysiu. Esu Ardavoje.“",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 3692814,
      "speechStartFrame": 3694464,
      "speechEndFrame": 3770664,
      "endFrame": 3784314,
      "start": 153.86725,
      "end": 157.67975,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-019-i-006.mp3"
    },
    {
      "mark": "p-019-i-007",
      "block": 19,
      "item": 7,
      "text": "Lina palaikė jo krepšį,",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 3784314,
      "speechStartFrame": 3797964,
      "speechEndFrame": 3832464,
      "endFrame": 3833664,
      "start": 157.67975,
      "end": 159.736,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-019-i-007.mp3"
    },
    {
      "mark": "p-019-i-008",
      "block": 19,
      "item": 8,
      "text": "kol jis rašė.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 3833664,
      "speechStartFrame": 3834864,
      "speechEndFrame": 3857064,
      "endFrame": 3870264,
      "start": 159.736,
      "end": 161.261,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-019-i-008.mp3"
    },
    {
      "mark": "p-019-i-009",
      "block": 19,
      "item": 9,
      "text": "Neskubėjo į parduotuvę.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 3870264,
      "speechStartFrame": 3883464,
      "speechEndFrame": 3917064,
      "endFrame": 3930414,
      "start": 161.261,
      "end": 163.76725,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-019-i-009.mp3"
    },
    {
      "mark": "p-020-i-000",
      "block": 20,
      "item": 0,
      "text": "Lina nupirko duonos ir siūlų.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 3930414,
      "speechStartFrame": 3943764,
      "speechEndFrame": 3986364,
      "endFrame": 4000464,
      "start": 163.76725,
      "end": 166.686,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-020-i-000.mp3"
    },
    {
      "mark": "p-020-i-001",
      "block": 20,
      "item": 1,
      "text": "Matas nupirko dar du obuolius.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 4000464,
      "speechStartFrame": 4014564,
      "speechEndFrame": 4061964,
      "endFrame": 4075764,
      "start": 166.686,
      "end": 169.8235,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-020-i-001.mp3"
    },
    {
      "mark": "p-020-i-002",
      "block": 20,
      "item": 2,
      "text": "Vieną padavė jai.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 4075764,
      "speechStartFrame": 4089564,
      "speechEndFrame": 4118364,
      "endFrame": 4142016,
      "start": 169.8235,
      "end": 172.584,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-020-i-002.mp3"
    },
    {
      "mark": "p-021-i-000",
      "block": 21,
      "item": 0,
      "text": "— Žinau knygą „Senas kelias“.",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 4142016,
      "speechStartFrame": 4144416,
      "speechEndFrame": 4190016,
      "endFrame": 4203216,
      "start": 172.584,
      "end": 175.134,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-021-i-000.mp3"
    },
    {
      "mark": "p-021-i-001",
      "block": 21,
      "item": 1,
      "text": "Ji gali padėti rasti kelią",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 4203216,
      "speechStartFrame": 4216416,
      "speechEndFrame": 4253316,
      "endFrame": 4253616,
      "start": 175.134,
      "end": 177.234,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-021-i-001.mp3"
    },
    {
      "mark": "p-021-i-002",
      "block": 21,
      "item": 2,
      "text": "į vietą, kurioje žmogus buvo anksčiau.",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 4253616,
      "speechStartFrame": 4253916,
      "speechEndFrame": 4311516,
      "endFrame": 4324266,
      "start": 177.234,
      "end": 180.17775,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-021-i-002.mp3"
    },
    {
      "mark": "p-021-i-003",
      "block": 21,
      "item": 3,
      "text": "Bet dabar jos neturiu.",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 4324266,
      "speechStartFrame": 4337016,
      "speechEndFrame": 4371516,
      "endFrame": 4384416,
      "start": 180.17775,
      "end": 182.684,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-021-i-003.mp3"
    },
    {
      "mark": "p-021-i-004",
      "block": 21,
      "item": 4,
      "text": "Nežinau, kas ją saugo.",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 4384416,
      "speechStartFrame": 4397316,
      "speechEndFrame": 4432716,
      "endFrame": 4457088,
      "start": 182.684,
      "end": 185.712,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-021-i-004.mp3"
    },
    {
      "mark": "p-022-i-000",
      "block": 22,
      "item": 0,
      "text": "Tuo metu Elzė skaitė toliau.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 4457088,
      "speechStartFrame": 4463088,
      "speechEndFrame": 4510188,
      "endFrame": 4523088,
      "start": 185.712,
      "end": 188.462,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-022-i-000.mp3"
    },
    {
      "mark": "p-022-i-001",
      "block": 22,
      "item": 1,
      "text": "Knygoje dukra gavo mažą namą.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 4523088,
      "speechStartFrame": 4535988,
      "speechEndFrame": 4583688,
      "endFrame": 4597788,
      "start": 188.462,
      "end": 191.5745,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-022-i-001.mp3"
    },
    {
      "mark": "p-022-i-002",
      "block": 22,
      "item": 2,
      "text": "Tėvas norėjo jai padaryti kėdę.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 4597788,
      "speechStartFrame": 4611888,
      "speechEndFrame": 4657488,
      "endFrame": 4672488,
      "start": 191.5745,
      "end": 194.687,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-022-i-002.mp3"
    },
    {
      "mark": "p-022-i-003",
      "block": 22,
      "item": 3,
      "text": "Dukra pasiūlė nupirkti naują.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 4672488,
      "speechStartFrame": 4687488,
      "speechEndFrame": 4730088,
      "endFrame": 4742688,
      "start": 194.687,
      "end": 197.612,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-022-i-003.mp3"
    },
    {
      "mark": "p-022-i-004",
      "block": 22,
      "item": 4,
      "text": "Jis atsakė, kad medžio dar turi.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 4742688,
      "speechStartFrame": 4755288,
      "speechEndFrame": 4800588,
      "endFrame": 4814088,
      "start": 197.612,
      "end": 200.587,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-022-i-004.mp3"
    },
    {
      "mark": "p-022-i-005",
      "block": 22,
      "item": 5,
      "text": "Elzė perskaitė jo atsakymą antrą kartą.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 4814088,
      "speechStartFrame": 4827588,
      "speechEndFrame": 4892988,
      "endFrame": 4905888,
      "start": 200.587,
      "end": 204.412,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-022-i-005.mp3"
    },
    {
      "mark": "p-023-i-000",
      "block": 23,
      "item": 0,
      "text": "Jie grįžo. Matas nunešė siūlus Elzei.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 4905888,
      "speechStartFrame": 4918788,
      "speechEndFrame": 5013888,
      "endFrame": 5026638,
      "start": 204.412,
      "end": 209.44325,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-023-i-000.mp3"
    },
    {
      "mark": "p-023-i-001",
      "block": 23,
      "item": 1,
      "text": "Lina paėmė duoną į biblioteką.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 5026638,
      "speechStartFrame": 5039388,
      "speechEndFrame": 5083788,
      "endFrame": 5096838,
      "start": 209.44325,
      "end": 212.36825,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-023-i-001.mp3"
    },
    {
      "mark": "p-023-i-002",
      "block": 23,
      "item": 2,
      "text": "Padėjo ją ant virtuvės stalo",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 5096838,
      "speechStartFrame": 5109888,
      "speechEndFrame": 5147988,
      "endFrame": 5148138,
      "start": 212.36825,
      "end": 214.50575,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-023-i-002.mp3"
    },
    {
      "mark": "p-023-i-003",
      "block": 23,
      "item": 3,
      "text": "ir nuėjo į kambario galą.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 5148138,
      "speechStartFrame": 5148288,
      "speechEndFrame": 5183388,
      "endFrame": 5196288,
      "start": 214.50575,
      "end": 216.512,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-023-i-003.mp3"
    },
    {
      "mark": "p-024-i-000",
      "block": 24,
      "item": 0,
      "text": "Ten turėjo būti mažos durys.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 5196288,
      "speechStartFrame": 5209188,
      "speechEndFrame": 5250588,
      "endFrame": 5263638,
      "start": 216.512,
      "end": 219.31825,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-024-i-000.mp3"
    },
    {
      "mark": "p-024-i-001",
      "block": 24,
      "item": 1,
      "text": "Dabar buvo tik siena.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 5263638,
      "speechStartFrame": 5276688,
      "speechEndFrame": 5307888,
      "endFrame": 5321238,
      "start": 219.31825,
      "end": 221.71825,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-024-i-001.mp3"
    },
    {
      "mark": "p-024-i-002",
      "block": 24,
      "item": 2,
      "text": "Lina palietė ją ranka.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 5321238,
      "speechStartFrame": 5334588,
      "speechEndFrame": 5369388,
      "endFrame": 5383038,
      "start": 221.71825,
      "end": 224.29325,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-024-i-002.mp3"
    },
    {
      "mark": "p-025-i-000",
      "block": 25,
      "item": 0,
      "text": "Matas grįžo prie jos.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 5383038,
      "speechStartFrame": 5396688,
      "speechEndFrame": 5433288,
      "endFrame": 5446038,
      "start": 224.29325,
      "end": 226.91825,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-025-i-000.mp3"
    },
    {
      "mark": "p-026-i-000",
      "block": 26,
      "item": 0,
      "text": "— Ką nors pametėte?",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 5446038,
      "speechStartFrame": 5458788,
      "speechEndFrame": 5486688,
      "endFrame": 5510016,
      "start": 226.91825,
      "end": 229.584,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-026-i-000.mp3"
    },
    {
      "mark": "p-027-i-000",
      "block": 27,
      "item": 0,
      "text": "— Vakar čia buvo durys.",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 5510016,
      "speechStartFrame": 5512416,
      "speechEndFrame": 5547216,
      "endFrame": 5560566,
      "start": 229.584,
      "end": 231.69025,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-027-i-000.mp3"
    },
    {
      "mark": "p-027-i-001",
      "block": 27,
      "item": 1,
      "text": "Už jų stovėjo senas mamos stalas.",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 5560566,
      "speechStartFrame": 5573916,
      "speechEndFrame": 5630316,
      "endFrame": 5643066,
      "start": 231.69025,
      "end": 235.12775,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-027-i-001.mp3"
    },
    {
      "mark": "p-027-i-002",
      "block": 27,
      "item": 2,
      "text": "Mama rašė knygas.",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 5643066,
      "speechStartFrame": 5655816,
      "speechEndFrame": 5690316,
      "endFrame": 5715648,
      "start": 235.12775,
      "end": 238.152,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-027-i-002.mp3"
    },
    {
      "mark": "p-028-i-000",
      "block": 28,
      "item": 0,
      "text": "— Kur dingo durys?",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 5715648,
      "speechStartFrame": 5719848,
      "speechEndFrame": 5748948,
      "endFrame": 5773248,
      "start": 238.152,
      "end": 240.552,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-028-i-000.mp3"
    },
    {
      "mark": "p-029-i-000",
      "block": 29,
      "item": 0,
      "text": "— Nežinau. Anksčiau dingo langas.",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 5773248,
      "speechStartFrame": 5775948,
      "speechEndFrame": 5853048,
      "endFrame": 5865648,
      "start": 240.552,
      "end": 244.402,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-029-i-000.mp3"
    },
    {
      "mark": "p-029-i-001",
      "block": 29,
      "item": 1,
      "text": "Ateikite vakare. Paieškosime mano knygų užrašuose.",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 5865648,
      "speechStartFrame": 5878248,
      "speechEndFrame": 5989248,
      "endFrame": 6001698,
      "start": 244.402,
      "end": 250.07075,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-029-i-001.mp3"
    },
    {
      "mark": "p-029-i-002",
      "block": 29,
      "item": 2,
      "text": "Gal rasime jūsų knygą.",
      "voice": "lt-LT-OnaNeural",
      "startFrame": 6001698,
      "speechStartFrame": 6014148,
      "speechEndFrame": 6051948,
      "endFrame": 6075648,
      "start": 250.07075,
      "end": 253.152,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-029-i-002.mp3"
    },
    {
      "mark": "p-030-i-000",
      "block": 30,
      "item": 0,
      "text": "Lina paėmė dar vieną popieriaus lapą.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 6075648,
      "speechStartFrame": 6079548,
      "speechEndFrame": 6134748,
      "endFrame": 6147648,
      "start": 253.152,
      "end": 256.152,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-030-i-000.mp3"
    },
    {
      "mark": "p-030-i-001",
      "block": 30,
      "item": 1,
      "text": "Užrašė datą ir žodžius „Dingo durys“.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 6147648,
      "speechStartFrame": 6160548,
      "speechEndFrame": 6220548,
      "endFrame": 6233298,
      "start": 256.152,
      "end": 259.72075,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-030-i-001.mp3"
    },
    {
      "mark": "p-031-i-000",
      "block": 31,
      "item": 0,
      "text": "Matas užrašė adresą ant popieriaus.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 6233298,
      "speechStartFrame": 6246048,
      "speechEndFrame": 6300048,
      "endFrame": 6312048,
      "start": 259.72075,
      "end": 263.002,
      "audio": "assets/audio/keliaujanti-biblioteka/chapter-2/p-031-i-000.mp3"
    },
    {
      "mark": "p-031-i-001",
      "block": 31,
      "item": 1,
      "text": "Sąsiuvinį įsidėjo į krepšį.",
      "voice": "lt-LT-LeonasNeural",
      "startFrame": 6312048,
      "speechStartFrame": 6324048,
      "speechEndFrame": 6366948,
      "endFrame": 6379848,
      "start": 263.002,
